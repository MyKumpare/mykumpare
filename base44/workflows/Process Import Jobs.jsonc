{
  "name": "Process Import Jobs",
  "description": "Drives server-side import jobs in the background. Whenever an ImportJob is created or updated while still 'enriching' (progress < total), it runs the next chunk \u2014 enriching one pending firm per run. The job's own progress updates re-trigger this workflow, so it self-drives to completion and survives navigation/close.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "ImportJob",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"enriching\" and ((.trigger.data.progress // 0) < (.trigger.data.total // 0)) }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "process_import_jobs",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_chunk": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processImportJobChunk",
            "args": {
              "job_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Process next import item",
            "description": "Enriches one pending record"
          }
        }
      }
    ]
  }
}