  "name": "Process Import Jobs",
  "description": "Drives server-side import jobs in the background. Runs every 5 minutes and processes pending enrichment items for all active import jobs. Each run enriches as many pending firms as possible within the function timeout, then the next scheduled run continues until all jobs are complete.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
