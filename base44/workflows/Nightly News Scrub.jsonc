{
  "name": "Nightly News Scrub",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 2 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Overnight AI scrub of public news for all firms, their contacts, and products. Creates FirmNews records with alert status, sentiment, and article links.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "nightly_news_scrub",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "scrub_all": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scrubFirmNews",
            "args": {
              "mode": "all"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Scrub news for all firms",
            "description": "Enqueues every firm for overnight AI news scrub"
          }
        }
      }
    ]
  }
}