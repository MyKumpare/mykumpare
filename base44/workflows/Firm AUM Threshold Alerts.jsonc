{
  "name": "Firm AUM Threshold Alerts",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "firm_aum_threshold_alerts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_aum_thresholds": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkFirmAumThresholds",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Check firm AUM thresholds",
            "description": "Sweep each firm's latest AUM vs per-firm thresholds"
          }
        }
      }
    ]
  },
  "description": "Daily sweep that checks each firm's latest month-end AUM against its configured per-firm AUM threshold and raises FirmAumAlert records for any firm whose AUM falls below it. Complements the real-time check that can be triggered manually from the firm profile."
}