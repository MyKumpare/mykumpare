{
  "name": "Scoring Threshold Alerts",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "scoring_threshold_alerts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_thresholds": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkScoringThresholds",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Check scoring thresholds",
            "description": "Sweep finalized scores vs per-firm thresholds"
          }
        }
      }
    ]
  },
  "description": "Daily sweep that checks all finalized scoring matrices against each firm's configured per-firm threshold and raises ScoringThresholdAlert records for any that fall below it. Complements the real-time check that fires on finalization."
}