{
  "name": "External Invitation Reminders",
  "description": "Daily check: if an external party invitation hasn't been accepted after 3 days, send a follow-up reminder email to the internal user who created it.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "external_invitation_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendPendingInvitationReminders"
          },
          "then": "end",
          "x-base44": {
            "title": "Send reminder emails",
            "description": "Nudge inviters of 3-day-pending external invitations"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}