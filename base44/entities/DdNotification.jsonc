{
  "name": "DdNotification",
  "type": "object",
  "properties": {
    "contact_id": {
      "type": "string",
      "description": "ID of the contact to notify"
    },
    "contact_name": {
      "type": "string",
      "description": "Name of the notified contact (denormalized)"
    },
    "type": {
      "type": "string",
      "enum": [
        "supervisor_request",
        "approval_decision",
        "questionnaire_sent",
        "questionnaire_submitted",
        "questionnaire_completed",
        "external_chat",
        "coverage_assignment"
      ],
      "description": "Type of notification. 'external_chat' is a chat message from an external firm user to the primary analyst. 'coverage_assignment' is an alert to an analyst when they are newly assigned as primary or secondary analyst on a due diligence record (or a new firm is added to their coverage)."
    },
    "title": {
      "type": "string",
      "description": "Short title of the notification"
    },
    "message": {
      "type": "string",
      "description": "Detailed message body"
    },
    "due_diligence_id": {
      "type": "string",
      "description": "ID of the related DueDiligence record"
    },
    "questionnaire_id": {
      "type": "string",
      "description": "ID of the related Questionnaire record (for questionnaire notifications)"
    },
    "firm_name": {
      "type": "string",
      "description": "Firm name (denormalized)"
    },
    "product_name": {
      "type": "string",
      "description": "Product name (denormalized)"
    },
    "stage_name": {
      "type": "string",
      "description": "Stage name this notification refers to (denormalized)"
    },
    "supervisor_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "on_hold"
      ],
      "description": "Supervisor status this notification was created for"
    },
    "external_chat_id": {
      "type": "string",
      "description": "ID of the related ExternalChat record (for external_chat notifications)"
    },
    "coverage_role": {
      "type": "string",
      "enum": [
        "primary",
        "secondary"
      ],
      "description": "For 'coverage_assignment' notifications: whether the analyst was assigned as primary or secondary analyst."
    },
    "status": {
      "type": "string",
      "enum": [
        "unread",
        "read",
        "completed"
      ],
      "default": "unread",
      "description": "Whether the notification has been read. 'completed' means the requested action has been fulfilled (e.g. supervisor made a decision, analyst responded to a chat)."
    }
  },
  "required": [
    "contact_id",
    "type",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.contact_id": "{{user.data.linked_contact_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}