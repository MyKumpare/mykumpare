{
  "name": "FollowUpTask",
  "type": "object",
  "properties": {
    "originator_contact_id": {
      "type": "string",
      "description": "ID of the contact who created this task"
    },
    "originator_contact_name": {
      "type": "string",
      "description": "Full name of the originator (denormalized)"
    },
    "originator_firm_id": {
      "type": "string",
      "description": "ID of the originator's firm"
    },
    "originator_firm_name": {
      "type": "string",
      "description": "Name of the originator's firm (denormalized)"
    },
    "activity_id": {
      "type": "string",
      "description": "ID of the associated ContactActivity (optional)"
    },
    "activity_label": {
      "type": "string",
      "description": "Short label of the associated activity (denormalized)"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Due date of the task (YYYY-MM-DD)"
    },
    "task_description": {
      "type": "string",
      "description": "Task description / memo (rich text HTML)"
    },
    "assigned_firms_contacts": {
      "type": "array",
      "description": "Firms and contacts this task is assigned to (multi-firm/multi-contact)",
      "items": {
        "type": "object",
        "properties": {
          "firm_id": {
            "type": "string"
          },
          "firm_name": {
            "type": "string"
          },
          "contacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "contact_id": {
                  "type": "string"
                },
                "contact_name": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "assigned_to_contact_id": {
      "type": "string",
      "description": "Primary assignee contact ID (denormalized for quick filtering)"
    },
    "assigned_to_contact_name": {
      "type": "string",
      "description": "Primary assignee name (denormalized)"
    },
    "assigned_to_firm_id": {
      "type": "string",
      "description": "Primary assignee firm ID (denormalized for quick filtering)"
    },
    "assigned_to_firm_name": {
      "type": "string",
      "description": "Primary assignee firm name (denormalized)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Not Started",
        "In-process",
        "Completed",
        "Cancelled"
      ],
      "default": "Not Started",
      "description": "Current status of the task"
    },
    "status_date": {
      "type": "string",
      "format": "date",
      "description": "Date when the status was last changed (auto-set on status change)"
    },
    "completion_date": {
      "type": "string",
      "format": "date",
      "description": "Date the task was completed"
    },
    "notes": {
      "type": "string",
      "description": "Notes on the task (rich text HTML)"
    },
    "parent_task_id": {
      "type": "string",
      "description": "If this task is a sub-task, points to the parent task id"
    },
    "attachments": {
      "type": "array",
      "description": "Files attached to this task",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "User-defined display name for the file"
          },
          "file_url": {
            "type": "string",
            "description": "URL of the uploaded file"
          },
          "file_type": {
            "type": "string",
            "description": "MIME type or extension"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "required": [
    "originator_contact_id",
    "due_date",
    "task_description",
    "status"
  ]
}