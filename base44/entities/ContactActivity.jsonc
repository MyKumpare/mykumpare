{
  "name": "ContactActivity",
  "type": "object",
  "properties": {
    "contact_id": {
      "type": "string",
      "description": "ID of the associated contact"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "Call",
        "Email",
        "Meeting",
        "Note",
        "Other"
      ],
      "description": "Type of activity"
    },
    "activity_date": {
      "type": "string",
      "format": "date",
      "description": "Date the activity took place"
    },
    "subject": {
      "type": "string",
      "description": "Short subject or title of the activity"
    },
    "notes": {
      "type": "string",
      "description": "Detailed notes about the activity"
    },
    "associated_firms_contacts": {
      "type": "array",
      "description": "Firms and contacts associated with this activity log",
      "items": {
        "type": "object",
        "properties": {
          "firm_id": {
            "type": "string"
          },
          "firm_name": {
            "type": "string"
          },
          "contacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "contact_id": {
                  "type": "string"
                },
                "contact_name": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "contact_id",
    "activity_type",
    "activity_date"
  ]
}