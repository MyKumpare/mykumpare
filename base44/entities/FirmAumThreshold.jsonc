{
  "name": "FirmAumThreshold",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "ID of the firm (tenant) that owns this threshold setting. Set on creation to the creator's linked_firm_id; drives tenant isolation via RLS."
    },
    "firm_id": {
      "type": "string",
      "description": "ID of the firm this per-firm AUM threshold applies to. One setting per firm."
    },
    "firm_name": {
      "type": "string",
      "description": "Name of the firm (denormalized for display)."
    },
    "threshold": {
      "type": "number",
      "description": "Minimum acceptable firm AUM (in dollars). When the firm's latest month-end AUM falls below this value, a FirmAumAlert with alert_type 'below_min' is created."
    },
    "max_threshold": {
      "type": "number",
      "description": "Maximum acceptable firm AUM (in dollars). When the firm's latest month-end AUM exceeds this value, a FirmAumAlert with alert_type 'above_max' is created. Leave empty to only monitor the minimum (below) threshold."
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether AUM threshold checking is active for this firm. When false, the daily sweep and real-time check skip this firm."
    },
    "created_by_id": {
      "type": "string",
      "description": "ID of the user who created this setting (auto-set by platform)."
    }
  },
  "required": [
    "firm_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.linked_firm_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.linked_firm_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.linked_firm_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.firm_role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "data.firm_role": "co-admin"
                  }
                },
                {
                  "user_condition": {
                    "data.can_edit": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.linked_firm_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.firm_role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "data.firm_role": "co-admin"
                  }
                },
                {
                  "user_condition": {
                    "data.can_delete": true
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}