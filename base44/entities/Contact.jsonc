{
  "name": "Contact",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "ID of the firm (tenant) that owns this contact record. Set on creation to the creator's linked_firm_id; drives tenant isolation via RLS."
    },
    "photo_url": {
      "type": "string",
      "description": "URL of the contact's photo"
    },
    "salutation": {
      "type": "string",
      "enum": [
        "Mr.",
        "Ms.",
        "Mrs.",
        "Dr.",
        "Prof.",
        "Hon."
      ],
      "description": "Salutation/title prefix"
    },
    "first_name": {
      "type": "string",
      "description": "First name of the contact"
    },
    "middle_name": {
      "type": "string",
      "description": "Middle name of the contact"
    },
    "last_name": {
      "type": "string",
      "description": "Last name of the contact"
    },
    "suffix": {
      "type": "string",
      "enum": [
        "Jr.",
        "Sr.",
        "II",
        "III",
        "IV",
        "Esq.",
        "CFA",
        "CPA",
        "MBA",
        "PhD",
        "MD"
      ],
      "description": "Name suffix"
    },
    "title": {
      "type": "string",
      "description": "Job title of the contact"
    },
    "reports_to_contact_id": {
      "type": "string",
      "description": "ID of the contact this person reports to within the same firm. Used to build the firm's reporting hierarchy (who reports to whom). Set via the 'Reports To' picker on the contact form, filtered to active contacts at the same firm(s). Empty means this contact has no manager link (appears as a root node in the firm's reporting structure)."
    },
    "designations": {
      "type": "array",
      "description": "Professional designations",
      "items": {
        "type": "string"
      }
    },
    "email": {
      "type": "string",
      "description": "Email address of the contact"
    },
    "linkedin_url": {
      "type": "string",
      "description": "LinkedIn profile URL of the contact"
    },
    "employee_status": {
      "type": "string",
      "enum": [
        "Employee",
        "Non-Employee"
      ],
      "description": "Whether the contact is an employee or non-employee"
    },
    "contact_status": {
      "type": "string",
      "enum": [
        "Active",
        "Inactive"
      ],
      "default": "Active",
      "description": "Whether the contact is active or inactive"
    },
    "engagement_status": {
      "type": "string",
      "enum": [
        "New",
        "Engaged",
        "Archived"
      ],
      "default": "New",
      "description": "Visual relationship status tracker \u2014 'New' = newly added contact not yet engaged with; 'Engaged' = actively in conversation / relationship building; 'Archived' = no longer being pursued or kept for historical record. Shown as a colored stepper in the contact profile so the team can see relationship progress at a glance."
    },
    "contact_role": {
      "type": "string",
      "enum": [
        "Primary",
        "Secondary"
      ],
      "description": "Whether this is a primary or secondary contact"
    },
    "decision_role": {
      "type": "string",
      "enum": [
        "Primary Decision Maker",
        "Board Member",
        "Key Influencer",
        "Secondary Contact",
        "Other"
      ],
      "description": "The contact's decision-making role within the firm \u2014 classifies whether this person is a primary decision maker, board member, key influencer, or secondary contact. Used by the contact network dashboard to highlight key nodes and by contact lists to surface decision makers at a glance."
    },
    "influence_level": {
      "type": "string",
      "enum": [
        "Final Decision Maker",
        "Decision Maker",
        "Influencer",
        "Follower",
        "Undetermined"
      ],
      "default": "Undetermined",
      "description": "The contact's influence level \u2014 a user-assigned rating of how much sway this person holds in investment decisions. 'Final Decision Maker' = ultimate authority who signs off on investment decisions; 'Decision Maker' = final say on investment decisions; 'Influencer' = shapes decisions without final authority; 'Follower' = minimal direct influence; 'Undetermined' = not yet assessed (default for new contacts). Used alongside decision_role to prioritize relationship management effort."
    },
    "contact_type": {
      "type": "array",
      "description": "Classification type(s) of the contact (multi-select, defaults from associated firm type)",
      "items": {
        "type": "string"
      }
    },
    "contact_roles": {
      "type": "array",
      "description": "Roles the contact holds (e.g. CIO, Portfolio Manager)",
      "items": {
        "type": "string"
      }
    },
    "contact_firm_roles": {
      "type": "array",
      "description": "Department roles the contact holds within the firm (for IM/MoM firms)",
      "items": {
        "type": "string"
      }
    },
    "investment_team_roles": {
      "type": "array",
      "description": "Investment team role(s) the contact holds (e.g. Managing Partner, Analyst, General Counsel), drawn from the shared InvestmentTeamRole library. Assigned during contact creation to track team composition across the firm portfolio.",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "description": "User-assigned tags for labeling contacts by role or category (e.g. Investor, Board Member, Advisor), drawn from the shared ContactTag library. Used to quickly filter and group contacts on the main contact list.",
      "items": {
        "type": "string"
      }
    },
    "gender": {
      "type": "string",
      "enum": [
        "Male",
        "Female",
        "Undetermined"
      ],
      "default": "Undetermined",
      "description": "Gender of the contact"
    },
    "ethnicity": {
      "type": "array",
      "description": "Ethnicity of the contact (multi-select)",
      "items": {
        "type": "string",
        "enum": [
          "African American",
          "Asian American",
          "Caucasian",
          "Latino American",
          "Native American Indian",
          "Native Alaskan Indian"
        ]
      }
    },
    "veteran_status": {
      "type": "string",
      "enum": [
        "Veteran Owned",
        "Non-Veteran Owned",
        "Undetermined"
      ],
      "default": "Undetermined",
      "description": "Veteran ownership status"
    },
    "disability_status": {
      "type": "string",
      "enum": [
        "Disabled",
        "Non-Disabled",
        "Undetermined"
      ],
      "default": "Undetermined",
      "description": "Disability status"
    },
    "biography": {
      "type": "string",
      "description": "Biography of the contact"
    },
    "bio_url": {
      "type": "string",
      "description": "URL of the contact's individual profile/biography page on their firm's website (stored during auto-fill enrichment so the user can re-scrape it if the initial extraction missed data)"
    },
    "education": {
      "type": "array",
      "description": "Education history of the contact",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "institution": {
            "type": "string",
            "description": "School / university / institution name"
          },
          "graduation_year": {
            "type": "string"
          },
          "degree": {
            "type": "string"
          },
          "area_of_specialization": {
            "type": "string"
          },
          "majors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "minors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "professional_experience": {
      "type": "array",
      "description": "Professional experience history of the contact",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "company_name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "start_year": {
            "type": "string"
          },
          "end_year": {
            "type": "string"
          }
        }
      }
    },
    "board_memberships": {
      "type": "array",
      "description": "Board memberships and trustee positions held by the contact, extracted from their biography/professional experience during the auto-fill website enrichment process. Each entry records the organization, the role held (e.g. Board Member, Trustee, Chairman), and the start/end years.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "organization_name": {
            "type": "string",
            "description": "Name of the organization whose board the contact serves/served on"
          },
          "role": {
            "type": "string",
            "description": "Role on the board (e.g. Board Member, Trustee, Chairman, Director)"
          },
          "start_year": {
            "type": "string",
            "description": "Year the contact joined the board"
          },
          "end_year": {
            "type": "string",
            "description": "Year the contact left the board (empty if current)"
          }
        }
      }
    },
    "firm_ids": {
      "type": "array",
      "description": "IDs of the associated firms",
      "items": {
        "type": "string"
      }
    },
    "phones": {
      "type": "array",
      "description": "List of phone numbers for the contact",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "phone_type": {
            "type": "string"
          },
          "country_code": {
            "type": "string"
          },
          "area_code": {
            "type": "string"
          },
          "number_mid": {
            "type": "string"
          },
          "number_last": {
            "type": "string"
          },
          "is_default": {
            "type": "boolean"
          }
        }
      }
    },
    "addresses": {
      "type": "array",
      "description": "List of addresses for the contact",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "is_primary": {
            "type": "boolean"
          },
          "country": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "postal_code": {
            "type": "string"
          },
          "address_line1": {
            "type": "string"
          },
          "address_line2": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "description": "Geocoded latitude for this address (used by map search to skip re-geocoding)"
          },
          "longitude": {
            "type": "number",
            "description": "Geocoded longitude for this address (used by map search to skip re-geocoding)"
          }
        }
      }
    },
    "pipeline_stage": {
      "type": "string",
      "description": "Current pipeline stage for the contact Kanban board (name of a ContactPipelineStage record). Empty means that the contact has not been placed in the pipeline yet; it appears in the first stage column until moved."
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the contact"
    },
    "primary_xponance_contact_id": {
      "type": "string",
      "description": "ID of the primary Xponance contact assigned to this contact. The assigned contact must belong to the Xponance (tenant) firm. Set via the Xponance Contact Picker in the contact edit form."
    },
    "primary_xponance_contact_name": {
      "type": "string",
      "description": "Full name of the primary Xponance contact (denormalized for display in badges and the Xponance dashboard)."
    },
    "secondary_xponance_contact_id": {
      "type": "string",
      "description": "ID of the secondary Xponance contact assigned to this contact. The assigned contact must belong to the Xponance (tenant) firm. Set via the Xponance Contact Picker in the contact edit form."
    },
    "secondary_xponance_contact_name": {
      "type": "string",
      "description": "Full name of the secondary Xponance contact (denormalized for display in badges and the Xponance dashboard)."
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the contact was soft-deleted"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.linked_firm_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.linked_firm_id}}"
        },
        {
          "data.id": "{{user.data.linked_contact_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.linked_firm_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.firm_role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "data.firm_role": "co-admin"
                  }
                },
                {
                  "user_condition": {
                    "data.can_edit": true
                  }
                }
              ]
            }
          ]
        },
        {
          "data.id": "{{user.data.linked_contact_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.linked_firm_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.firm_role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "data.firm_role": "co-admin"
                  }
                },
                {
                  "user_condition": {
                    "data.can_delete": true
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}