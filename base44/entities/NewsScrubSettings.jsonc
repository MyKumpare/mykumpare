{
  "name": "NewsScrubSettings",
  "type": "object",
  "properties": {
    "keywords": {
      "type": "array",
      "description": "Keywords to prioritize during the nightly news scrub. These are passed to the AI search prompt for every firm so the scrub focuses on topics the team cares about (e.g. 'SEC action', 'fund closure', 'leadership departure').",
      "items": {
        "type": "string"
      }
    },
    "label": {
      "type": "string",
      "description": "Optional display label for this settings record (defaults to 'Default')."
    },
    "schedule_time": {
      "type": "string",
      "description": "Time of day to run the nightly news scrub, in 24-hour HH:MM format (e.g. '02:00'). Defaults to '02:00' (2:00 AM Eastern)."
    },
    "schedule_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the nightly news scrub workflow is enabled. When false, the scheduled scrub is skipped."
    }
  },
  "required": [
    "keywords"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}