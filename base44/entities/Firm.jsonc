{
  "name": "Firm",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "ID of the firm (tenant) that owns this firm record. For a tenant's own organization firm, this equals the record's own id. Drives tenant isolation via RLS."
    },
    "name": {
      "type": "string",
      "description": "Name of the firm"
    },
    "firm_type": {
      "type": "string",
      "enum": [
        "Manager of Managers",
        "Investment Manager",
        "Allocator",
        "Investment Consultant",
        "Securities Brokerage",
        "Trade Organizations"
      ],
      "description": "Primary type of firm (legacy single value)"
    },
    "firm_types": {
      "type": "array",
      "description": "Types of firm (multi-select)",
      "items": {
        "type": "string",
        "enum": [
          "Manager of Managers",
          "Investment Manager",
          "Allocator",
          "Investment Consultant",
          "Securities Brokerage",
          "Trade Organizations"
        ]
      }
    },
    "logo_url": {
      "type": "string",
      "description": "URL of the firm's logo"
    },
    "website": {
      "type": "string",
      "description": "Website URL of the firm"
    },
    "linkedin_url": {
      "type": "string",
      "description": "LinkedIn profile URL of the firm"
    },
    "email": {
      "type": "string",
      "description": "General contact email address of the firm"
    },
    "year_founded": {
      "type": "integer",
      "description": "Year the firm was founded"
    },
    "description": {
      "type": "string",
      "description": "Description of the firm"
    },
    "addresses": {
      "type": "array",
      "description": "List of addresses for the firm",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "is_headquarters": {
            "type": "boolean"
          },
          "country": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "postal_code": {
            "type": "string"
          },
          "address_line1": {
            "type": "string"
          },
          "address_line2": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "description": "Geocoded latitude for this address (used by map search to skip re-geocoding)"
          },
          "longitude": {
            "type": "number",
            "description": "Geocoded longitude for this address (used by map search to skip re-geocoding)"
          }
        }
      }
    },
    "phones": {
      "type": "array",
      "description": "List of phone numbers for the firm",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "address_id": {
            "type": "string",
            "description": "ID of the associated address"
          },
          "phone_type": {
            "type": "string"
          },
          "country_code": {
            "type": "string"
          },
          "area_code": {
            "type": "string"
          },
          "number_mid": {
            "type": "string"
          },
          "number_last": {
            "type": "string"
          },
          "is_default": {
            "type": "boolean"
          }
        }
      }
    },
    "aum_history": {
      "type": "array",
      "description": "Monthly historical firm AUM data points. Each entry tracks month-end date, firm AUM, assets gained, assets loss, net asset flows (auto-calculated as assets_gained - assets_loss), and a per-date client type breakdown.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "month_end_date": {
            "type": "string",
            "format": "date",
            "description": "Month-end date of the AUM data point (YYYY-MM-DD, displayed as MM/DD/YYYY)"
          },
          "firm_aum": {
            "type": "number",
            "description": "Firm AUM at month-end"
          },
          "assets_gained": {
            "type": "number",
            "description": "Assets gained during the month (inflows)"
          },
          "assets_loss": {
            "type": "number",
            "description": "Assets lost during the month (outflows/redemptions)"
          },
          "net_asset_flows": {
            "type": "number",
            "description": "Net asset flows for the month (auto-calculated as assets_gained - assets_loss)"
          },
          "client_type_breakdown": {
            "type": "array",
            "description": "Breakdown of this month's AUM by client type. Each entry pairs a client type with an AUM amount. The sum of all entries is validated against this entry's firm_aum.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "client_type": {
                  "type": "string",
                  "description": "Client type name (from the ClientType master list)"
                },
                "aum_amount": {
                  "type": "number",
                  "description": "AUM attributed to this client type"
                }
              }
            }
          }
        }
      }
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the firm was soft-deleted"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.linked_firm_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.linked_firm_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.linked_firm_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.firm_role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "data.firm_role": "co-admin"
                  }
                },
                {
                  "user_condition": {
                    "data.can_edit": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.linked_firm_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.firm_role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "data.firm_role": "co-admin"
                  }
                },
                {
                  "user_condition": {
                    "data.can_delete": true
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}