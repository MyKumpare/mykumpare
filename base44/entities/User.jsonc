{
  "properties": {
    "role": {
      "type": "string",
      "description": "The built-in role of the user in the app (single platform role used for security)",
      "enum": [
        "admin",
        "user"
      ]
    },
    "roles": {
      "type": "array",
      "description": "Custom multi-select roles for display/tagging only (does not affect built-in permissions). A user may hold both 'admin' and 'user' here.",
      "items": {
        "type": "string",
        "enum": [
          "admin",
          "user"
        ]
      }
    },
    "is_owner": {
      "type": "boolean",
      "description": "True if this user is the designated owner of the application (top-level administrator who can manage users and roles)",
      "default": false
    },
    "linked_firm_id": {
      "type": "string",
      "description": "ID of the firm this user is affiliated with (self-linked from profile)"
    },
    "linked_contact_id": {
      "type": "string",
      "description": "ID of the contact record this user is linked to (self-linked from profile)"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}