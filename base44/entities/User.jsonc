{
  "properties": {
    "role": {
      "type": "string",
      "description": "The built-in platform role of the user in the app (single platform role used for app-level security)",
      "enum": [
        "admin",
        "user"
      ]
    },
    "roles": {
      "type": "array",
      "description": "Custom multi-select roles for display/tagging only (does not affect built-in permissions). A user may hold both 'admin' and 'user' here.",
      "items": {
        "type": "string",
        "enum": [
          "admin",
          "user"
        ]
      }
    },
    "is_owner": {
      "type": "boolean",
      "description": "True if this user is the designated owner of the application (top-level administrator who can manage users and roles)",
      "default": false
    },
    "linked_firm_id": {
      "type": "string",
      "description": "ID of the firm (tenant) this user is affiliated with. Acts as the tenant boundary for multi-tenant data isolation. Not set for external party users."
    },
    "linked_contact_id": {
      "type": "string",
      "description": "ID of the contact record this user is linked to (self-linked from profile or from external party invitation)"
    },
    "firm_role": {
      "type": "string",
      "description": "This user's role within their affiliated firm (tenant). Drives firm-level permissions: admin/co-admin have full edit+delete; a regular 'user' is gated by can_edit/can_delete.",
      "enum": [
        "admin",
        "co-admin",
        "user"
      ],
      "default": "user"
    },
    "can_edit": {
      "type": "boolean",
      "description": "Grants edit (update) permission on firm records for users whose firm_role is 'user'. Admins and co-admins always have edit access regardless of this flag.",
      "default": false
    },
    "can_delete": {
      "type": "boolean",
      "description": "Grants delete permission on firm records for users whose firm_role is 'user'. Admins and co-admins always have delete access regardless of this flag.",
      "default": false
    },
    "onboarded": {
      "type": "boolean",
      "description": "True once the user has completed the firm onboarding/join step (linked to a firm and contact record).",
      "default": false
    },
    "is_external_party": {
      "type": "boolean",
      "description": "True if this user is an external party (e.g., an external firm contact invited to complete a questionnaire). External party users only see questionnaires assigned to them via their linked_contact_id. They do not have linked_firm_id set and cannot access tenant-scoped data.",
      "default": false
    },
    "is_management": {
      "type": "boolean",
      "description": "True if this user is part of management. Only management users can see the Management section and its functions (Activity Timeline, Analyst Coverage, Firm Coverage). Set by an admin from the User Management page or by the user themselves from their profile if they are already management or an admin.",
      "default": false
    },
    "pinned_dashboard_reports": {
      "type": "array",
      "description": "User's pinned dashboard report/chart module keys, in display order. These charts auto-open (render inline) at the top of the Dashboard page. Each entry is a report module key from the Dashboard section modules (e.g. 'firm-category', 'database-growth', 'recently-added-firms').",
      "items": {
        "type": "string"
      }
    },
    "contact_card_format": {
      "type": "object",
      "description": "Per-user saved Contact Card format. Stores the selected card style (classic/modern/minimal/bold) and the ordered list of field definitions (id, label, enabled) so the user's card layout persists across sessions and contacts. Field values are not saved \u2014 they are re-derived per contact.",
      "properties": {
        "style": {
          "type": "string",
          "enum": [
            "classic",
            "modern",
            "minimal",
            "bold"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      }
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}