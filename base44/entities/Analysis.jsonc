{
  "name": "Analysis",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the analysis"
    },
    "is_template": {
      "type": "boolean",
      "description": "If true, this analysis acts as a reusable template"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "personal",
        "firm"
      ],
      "description": "personal = only creator; firm = anyone can view/edit but only creator can delete"
    },
    "created_by_id": {
      "type": "string",
      "description": "ID of the user who created this analysis"
    },
    "analysis_type": {
      "type": "string",
      "enum": [
        "single",
        "multiple"
      ],
      "description": "Single product or multiple product analysis"
    },
    "product_configs": {
      "type": "array",
      "description": "Per-product configuration for this analysis",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "firm_name": {
            "type": "string"
          },
          "benchmark_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "benchmark_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "return_type": {
            "type": "string",
            "enum": [
              "gross",
              "net",
              "both"
            ]
          },
          "include_clone_product": {
            "type": "boolean"
          },
          "include_clone_benchmark": {
            "type": "boolean"
          }
        }
      }
    },
    "period_start": {
      "type": "string",
      "description": "Analysis period start (MM/DD/YYYY format)"
    },
    "period_end": {
      "type": "string",
      "description": "Analysis period end (MM/DD/YYYY format)"
    },
    "use_common_period": {
      "type": "boolean"
    },
    "categories_config": {
      "type": "array",
      "description": "Full measurement category configurations including attributes, period config, and benchmark config",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "periods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "periodConfig": {
            "type": "object"
          },
          "benchmarkConfig": {
            "type": "object"
          }
        }
      }
    },
    "measurement_periods": {
      "type": "object",
      "description": "Legacy measurement periods configuration",
      "properties": {
        "trailing_periods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trailing_custom_start": {
          "type": "string"
        },
        "trailing_custom_end": {
          "type": "string"
        },
        "rolling_periods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rolling_custom_start": {
          "type": "string"
        },
        "rolling_custom_end": {
          "type": "string"
        },
        "include_cumulative": {
          "type": "boolean"
        },
        "calendar_years": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "historical_periods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "measurement_type": {
      "type": "object",
      "description": "Measurement type configuration",
      "properties": {
        "selected_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "view_mode": {
          "type": "string",
          "enum": [
            "table",
            "chart",
            "both"
          ]
        }
      }
    }
  },
  "required": [
    "name",
    "visibility",
    "analysis_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.visibility": "firm"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.visibility": "firm"
            },
            {
              "user_condition": {
                "role": "user"
              }
            }
          ]
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}