{
  "name": "Analysis",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the analysis"
    },
    "is_template": {
      "type": "boolean",
      "description": "If true, this analysis acts as a reusable template"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "personal",
        "firm"
      ],
      "description": "personal = only creator; firm = anyone can view/edit but only creator can delete"
    },
    "created_by_id": {
      "type": "string",
      "description": "ID of the user who created this analysis"
    },
    "analysis_type": {
      "type": "string",
      "enum": [
        "single",
        "multiple"
      ],
      "description": "Single product or multiple product analysis"
    },
    "product_configs": {
      "type": "array",
      "description": "Per-product configuration for this analysis",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "firm_name": {
            "type": "string"
          },
          "benchmark_ids": {
            "type": "array",
            "description": "Selected benchmark IDs (multi-select)",
            "items": {
              "type": "string"
            }
          },
          "benchmark_names": {
            "type": "array",
            "description": "Denormalized benchmark names",
            "items": {
              "type": "string"
            }
          },
          "benchmark_id": {
            "type": "string",
            "description": "Legacy single benchmark ID (kept for backwards compatibility)"
          },
          "benchmark_name": {
            "type": "string",
            "description": "Legacy single benchmark name"
          },
          "return_type": {
            "type": "string",
            "enum": [
              "gross",
              "net",
              "both"
            ]
          },
          "include_clone_product": {
            "type": "boolean"
          },
          "include_clone_benchmark": {
            "type": "boolean"
          }
        }
      }
    },
    "period_start": {
      "type": "string",
      "description": "Analysis period start (MM/DD/YYYY format)"
    },
    "period_end": {
      "type": "string",
      "description": "Analysis period end (MM/DD/YYYY format)"
    },
    "use_common_period": {
      "type": "boolean",
      "description": "Whether to use the common period across all selected products/benchmarks"
    },
    "measurement_periods": {
      "type": "object",
      "description": "Measurement periods configuration for performance analysis",
      "properties": {
        "trailing_periods": {
          "type": "array",
          "description": "Selected trailing periods",
          "items": {
            "type": "string",
            "enum": [
              "1M",
              "3M",
              "1Y",
              "3Y",
              "5Y",
              "7Y",
              "10Y",
              "since_inception",
              "custom"
            ]
          }
        },
        "trailing_custom_start": {
          "type": "string",
          "description": "Custom trailing period start date (MM/DD/YYYY)"
        },
        "trailing_custom_end": {
          "type": "string",
          "description": "Custom trailing period end date (MM/DD/YYYY)"
        },
        "rolling_periods": {
          "type": "array",
          "description": "Selected rolling periods",
          "items": {
            "type": "string",
            "enum": [
              "3M",
              "6M",
              "1Y",
              "3Y",
              "5Y",
              "7Y",
              "10Y",
              "custom"
            ]
          }
        },
        "rolling_custom_start": {
          "type": "string",
          "description": "Custom rolling period start date (MM/DD/YYYY)"
        },
        "rolling_custom_end": {
          "type": "string",
          "description": "Custom rolling period end date (MM/DD/YYYY)"
        },
        "include_cumulative": {
          "type": "boolean",
          "description": "Whether to include cumulative period"
        },
        "calendar_years": {
          "type": "array",
          "description": "Selected calendar years for analysis",
          "items": {
            "type": "integer"
          }
        },
        "historical_periods": {
          "type": "array",
          "description": "Selected historical return periods",
          "items": {
            "type": "string",
            "enum": [
              "monthly",
              "quarterly",
              "annually"
            ]
          }
        }
      }
    },
    "measurement_type": {
      "type": "object",
      "description": "Measurement type configuration for analytics calculations",
      "properties": {
        "selected_types": {
          "type": "array",
          "description": "Selected measurement categories",
          "items": {
            "type": "string",
            "enum": [
              "performance",
              "risk",
              "efficiency",
              "valueAtRisk",
              "population"
            ]
          }
        },
        "attributes": {
          "type": "array",
          "description": "Selected attributes across all categories",
          "items": {
            "type": "string"
          }
        },
        "view_mode": {
          "type": "string",
          "enum": [
            "table",
            "chart",
            "both"
          ],
          "description": "How to display the results"
        }
      }
    }
  },
  "required": [
    "name",
    "visibility",
    "analysis_type"
  ]
}