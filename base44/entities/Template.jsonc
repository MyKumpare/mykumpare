{
  "name": "Template",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "ID of the firm (tenant) that owns this template record. Set on creation to the creator's linked_firm_id; drives tenant isolation via RLS."
    },
    "name": {
      "type": "string",
      "description": "Name of the template"
    },
    "template_type": {
      "type": "string",
      "description": "Type category of the template (managed via TemplateType master list)"
    },
    "template_category": {
      "type": "string",
      "enum": [
        "Process Template",
        "Scoring Matrix"
      ],
      "description": "Whether this template is a process template (a staged workflow / due diligence process) or a scoring matrix (an evaluation scorecard used to rate managers)."
    },
    "create_date": {
      "type": "string",
      "format": "date",
      "description": "Date the template was created (auto-set to today, user-editable). Stored as YYYY-MM-DD."
    },
    "sample_file_url": {
      "type": "string",
      "description": "URL of an attached sample document showing how to use this template (optional). Supports PDF, Word, Excel, etc."
    },
    "sample_file_name": {
      "type": "string",
      "description": "Display name of the attached sample file (denormalized)."
    },
    "stages": {
      "type": "array",
      "description": "Due diligence stages for Manager Due Diligence templates (ordered list). Each stage has an id, a name, and optional sub-stages.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sub_stages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "documentation_checklist": {
      "type": "array",
      "description": "Documentation checklist items defined in the template.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "approval_process_logic": {
      "type": "array",
      "description": "Approval process logic steps defined in the template.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "stage_id": {
            "type": "string"
          },
          "stage_name": {
            "type": "string"
          },
          "sub_stage_id": {
            "type": "string"
          },
          "sub_stage_name": {
            "type": "string"
          }
        }
      }
    },
    "process_logic": {
      "type": "array",
      "description": "Process logic gate rules defined in the template. Each gate sits between two consecutive stages and defines the requirements that must all be satisfied before the process can advance to the next stage. Requirements can include sub-stage completion, document attachment, form completion, score card completion, qualitative/quantitative analysis, and approval. Copied to the DueDiligence record on creation.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for this gate rule"
          },
          "name": {
            "type": "string",
            "description": "Display name for this gate (e.g. 'Gate: Screening to Deep Dive')"
          },
          "from_stage_id": {
            "type": "string",
            "description": "ID of the stage that must be completed before this gate can pass"
          },
          "from_stage_name": {
            "type": "string",
            "description": "Name of the source stage (denormalized)"
          },
          "to_stage_id": {
            "type": "string",
            "description": "ID of the next stage that becomes available once this gate passes"
          },
          "to_stage_name": {
            "type": "string",
            "description": "Name of the destination stage (denormalized)"
          },
          "requirements": {
            "type": "array",
            "description": "Ordered list of requirements that must ALL be satisfied for this gate to pass. Each requirement has a type and type-specific reference fields.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "sub_stage_completion",
                    "document_attachment",
                    "form_completion",
                    "score_card_completion",
                    "qualitative_analysis",
                    "quantitative_analysis",
                    "approval"
                  ],
                  "description": "Type of requirement: sub_stage_completion = a specific sub-stage must be completed; document_attachment = a documentation checklist item must have a document attached; form_completion = a questionnaire/form must be completed; score_card_completion = a scoring matrix must be completed; qualitative_analysis = a qualitative analysis must be completed; quantitative_analysis = a quantitative analysis must be completed; approval = supervisor/approver approval is required."
                },
                "label": {
                  "type": "string",
                  "description": "Display label for this requirement (auto-generated from the type and reference, or user-customized)"
                },
                "stage_id": {
                  "type": "string",
                  "description": "For sub_stage_completion: the stage containing the sub-stage"
                },
                "sub_stage_id": {
                  "type": "string",
                  "description": "For sub_stage_completion: the specific sub-stage that must be completed (empty means all sub-stages in the stage)"
                },
                "document_checklist_item_id": {
                  "type": "string",
                  "description": "For document_attachment: the documentation checklist item ID that must have a document attached"
                },
                "form_id": {
                  "type": "string",
                  "description": "For form_completion: the questionnaire/form ID that must be completed"
                },
                "score_card_template_id": {
                  "type": "string",
                  "description": "For score_card_completion: the scoring matrix template ID that must be completed"
                },
                "analysis_description": {
                  "type": "string",
                  "description": "For qualitative_analysis / quantitative_analysis: a description of what analysis must be completed"
                },
                "approval_role": {
                  "type": "string",
                  "description": "For approval: the role of the approver who must approve (e.g. 'Supervisor', 'Investment Committee')"
                },
                "required": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether this requirement is mandatory (true) or optional (false). Optional requirements are shown but do not block the gate."
                }
              }
            }
          }
        }
      }
    },
    "stage_approvers": {
      "type": "array",
      "description": "Approver roles assigned to each stage at the template level. Each entry maps a stage to one or more approver roles (e.g. 'Supervisor', 'Investment Committee Chair') who must digitally sign off before the process can advance past that stage. Copied to the DueDiligence record on creation, where specific contacts are assigned to each role.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "stage_id": {
            "type": "string",
            "description": "ID of the stage these approver roles apply to"
          },
          "stage_name": {
            "type": "string",
            "description": "Name of the stage (denormalized)"
          },
          "approver_roles": {
            "type": "array",
            "description": "Approver roles required for this stage. Each role defines a label and whether sign-off is mandatory.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "description": "Approver role label (e.g. 'Supervisor', 'Investment Committee Chair')"
                },
                "required": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether this role's sign-off is mandatory (true) or optional (false). Optional roles are shown but do not block stage advancement."
                }
              }
            }
          }
        }
      }
    },
    "scoring_blocks": {
      "type": "array",
      "description": "Weighted scoring blocks for Scoring Matrix templates. Each block groups related criteria and has a percentage weight. The sum of all block weights should equal 100. An optional multiplier factor can be enabled per block (and per criterion) to scale its influence; effective weights are normalized so the overall total stays 100%.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Block name (e.g. 'Foundation', 'Making the Edge')"
          },
          "weight": {
            "type": "number",
            "description": "Percentage weight of this block (0-100)"
          },
          "multiplier_enabled": {
            "type": "boolean",
            "default": false,
            "description": "Whether a multiplier factor is active for this block (section). When true, the block's effective weight = weight \u00d7 multiplier, and all effective weights are normalized so the overall total stays 100%."
          },
          "multiplier": {
            "type": "number",
            "default": 1,
            "description": "Multiplier factor applied to this block's weight (e.g. 1.5 increases the block's influence by 50%, 0.5 halves it). Only used when multiplier_enabled is true. Effective weights are normalized across all blocks so the total remains 100%."
          },
          "criteria": {
            "type": "array",
            "description": "Scoring criteria within this block",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "number": {
                  "type": "integer",
                  "description": "Sequential criterion number"
                },
                "name": {
                  "type": "string",
                  "description": "Criterion name (e.g. 'Mandate & universe')"
                },
                "category": {
                  "type": "string",
                  "description": "Sub-category label (e.g. 'Investment research')"
                },
                "multiplier_enabled": {
                  "type": "boolean",
                  "default": false,
                  "description": "Whether a multiplier factor is active for this criterion (sub-section). When true, the criterion's contribution within its block is weighted by the multiplier value instead of equal weight."
                },
                "multiplier": {
                  "type": "number",
                  "default": 1,
                  "description": "Multiplier factor weighting this criterion within its block (e.g. 2 doubles the criterion's influence within the block relative to other criteria). Only used when multiplier_enabled is true; defaults to equal weighting (1) otherwise."
                },
                "descriptors": {
                  "type": "array",
                  "description": "Level descriptors (1-5) for this criterion",
                  "items": {
                    "type": "object",
                    "properties": {
                      "level": {
                        "type": "integer",
                        "description": "Score level (1-5)"
                      },
                      "text": {
                        "type": "string",
                        "description": "Descriptor text for this level"
                      }
                    }
                  }
                },
                "bonus_penalty_enabled": {
                  "type": "boolean",
                  "default": false,
                  "description": "Whether this criterion supports an optional bonus/penalty adjustment that analysts can activate during scoring review. When enabled, the analyst can apply a numeric adjustment within the configured range on top of the criterion's final score."
                },
                "bonus_penalty_range": {
                  "type": "object",
                  "description": "The allowed range for the bonus/penalty adjustment on this criterion. The analyst's adjustment value must fall within [min, max]. Min is typically negative (penalty) and max is positive (bonus).",
                  "properties": {
                    "min": {
                      "type": "number",
                      "description": "Minimum adjustment value (e.g. -1 for a 1-point penalty)."
                    },
                    "max": {
                      "type": "number",
                      "description": "Maximum adjustment value (e.g. +1 for a 1-point bonus)."
                    }
                  }
                },
                "bonus_penalty_guidance": {
                  "type": "string",
                  "description": "Instructions for the analyst on how and when to apply the bonus/penalty adjustment, and how it factors into the total score. Shown alongside the adjustment control during scoring review."
                }
              }
            }
          }
        }
      }
    },
    "rating_config": {
      "type": "object",
      "description": "Overall rating configuration for Scoring Matrix templates. Defines a Pass/Fail threshold and a set of rating options (each with a score range) that the system auto-assigns to a finalized scoring matrix based on its weighted final score. Configured once on the template and applied to every scoring matrix that uses it.",
      "properties": {
        "pass_fail_enabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether the Pass/Fail overall assessment is active for scoring matrices using this template."
        },
        "pass_threshold": {
          "type": "number",
          "description": "Minimum weighted final score (on the 1-5 scale) required to achieve a 'Pass'. A weighted final score below this value yields a 'Fail'. Only used when pass_fail_enabled is true."
        },
        "rating_enabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether the rating options (auto-assigned by score range) are active for scoring matrices using this template."
        },
        "rating_options": {
          "type": "array",
          "description": "Ordered list of rating options. Each option pairs a label (numerical or text, e.g. 'A', 'Buy', '5', 'Strong Buy') with a min/max weighted final score range. When a scoring matrix is finalized, the system finds the option whose range contains the weighted final score and assigns its label as the overall rating. Users can create, edit, and delete these options.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "description": "Rating label (numerical or text) shown as the overall rating when the weighted final score falls within this option's range."
              },
              "min_score": {
                "type": "number",
                "description": "Minimum weighted final score (inclusive) for this rating to apply."
              },
              "max_score": {
                "type": "number",
                "description": "Maximum weighted final score (inclusive) for this rating to apply."
              },
              "color": {
                "type": "string",
                "description": "Hex color used for the rating badge when this option is assigned."
              }
            }
          }
        }
      }
    },
    "version_number": {
      "type": "integer",
      "default": 1,
      "description": "Sequential version number for this template. Version 1 is the original; each 'Create New Version' action increments the version. Together with prior_version_id, this tracks the template's evolution history so users can create a new version by copying a prior one and modifying only what changed."
    },
    "prior_version_id": {
      "type": "string",
      "description": "ID of the prior Template this version was created from (empty for the original / version 1). Set when a user creates a new version by copying a prior template; links back to the source for historical tracking."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.linked_firm_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.linked_firm_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.linked_firm_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.firm_role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "data.firm_role": "co-admin"
                  }
                },
                {
                  "user_condition": {
                    "data.can_edit": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.linked_firm_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.firm_role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "data.firm_role": "co-admin"
                  }
                },
                {
                  "user_condition": {
                    "data.can_delete": true
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}