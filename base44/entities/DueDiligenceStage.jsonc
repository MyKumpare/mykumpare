{
  "name": "DueDiligenceStage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the due diligence stage (e.g. 'Pre-liminary Assessment')"
    },
    "position": {
      "type": "integer",
      "description": "Sort order (ascending). Displayed as 'Stage N - name' where N is the order index + 1."
    }
  },
  "required": [
    "name",
    "position"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}