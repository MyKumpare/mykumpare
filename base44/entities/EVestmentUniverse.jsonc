{
  "name": "EVestmentUniverse",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of a predefined eVestment Universe classification (managed master list, reusable across product eVestment Universe assignments). Users pick from these in the product eVestment Universe picker; new values typed in the picker or produced by the paste-and-scrub flow are persisted here so they join the shared library."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}