{
  "name": "DuplicateReview",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "enum": [
        "contact",
        "firm",
        "product"
      ],
      "default": "contact",
      "description": "Which entity type this accepted (dismissed) duplicate pair belongs to"
    },
    "contact_a_id": {
      "type": "string",
      "description": "First contact ID in an accepted (dismissed) duplicate pair (legacy field, used when entity_type is 'contact')"
    },
    "contact_b_id": {
      "type": "string",
      "description": "Second contact ID in an accepted (dismissed) duplicate pair (legacy field, used when entity_type is 'contact')"
    },
    "record_a_id": {
      "type": "string",
      "description": "First record ID in an accepted (dismissed) duplicate pair (generic field for firm/product duplicates)"
    },
    "record_b_id": {
      "type": "string",
      "description": "Second record ID in an accepted (dismissed) duplicate pair (generic field for firm/product duplicates)"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}