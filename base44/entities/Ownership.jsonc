{
  "name": "Ownership",
  "type": "object",
  "properties": {
    "firm_id": {
      "type": "string",
      "description": "ID of the associated firm"
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "description": "Date when this ownership breakdown became effective"
    },
    "owners": {
      "type": "array",
      "description": "List of owners in this breakdown",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "contact_id": {
            "type": "string"
          },
          "owner_type": {
            "type": "string",
            "enum": [
              "Employee",
              "Non-Employee"
            ]
          },
          "ownership_percentage": {
            "type": "number"
          },
          "contact_photo_url": {
            "type": "string"
          },
          "contact_full_name": {
            "type": "string"
          }
        }
      }
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this record was soft-deleted"
    }
  },
  "required": [
    "firm_id",
    "effective_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}