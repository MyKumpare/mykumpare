{
  "name": "ContactTag",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of a predefined contact tag (managed master list, reusable across contact tag assignments). Users pick from these in the contact tag picker to label contacts by role or category (e.g. Investor, Board Member, Advisor); new tags typed in the picker are persisted here so they join the shared library."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}