{
  "name": "ContactReminderSettings",
  "type": "object",
  "properties": {
    "days_threshold": {
      "type": "integer",
      "default": 30,
      "description": "Default number of days without a recorded interaction after which a contact is flagged as stale and an alert is generated. Used as the fallback when no tier-specific threshold is set for a contact's decision_role."
    },
    "tier_thresholds": {
      "type": "object",
      "description": "Per-tier custom day thresholds keyed by the contact's decision_role (e.g. 'Primary Decision Maker', 'Board Member', 'Key Influencer', 'Secondary Contact', 'Other'). Each value overrides the default days_threshold for contacts in that tier. Keys with no value or not present fall back to days_threshold. Set custom day limits for each group so alerts stay relevant to each tier's importance.",
      "properties": {
        "Primary Decision Maker": {
          "type": "integer",
          "description": "Days without interaction before a Primary Decision Maker is flagged. Shorter window \u2014 never lose touch with top decision makers."
        },
        "Board Member": {
          "type": "integer",
          "description": "Days without interaction before a Board Member is flagged."
        },
        "Key Influencer": {
          "type": "integer",
          "description": "Days without interaction before a Key Influencer is flagged."
        },
        "Secondary Contact": {
          "type": "integer",
          "description": "Days without interaction before a Secondary Contact is flagged."
        },
        "Other": {
          "type": "integer",
          "description": "Days without interaction before any other contact (no specific decision role) is flagged. Longest window \u2014 general rolodex."
        }
      },
      "default": {}
    },
    "schedule_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the daily stale-contact reminder check is enabled. When false, the scheduled workflow skips the check."
    },
    "schedule_time": {
      "type": "string",
      "description": "Time of day to run the daily stale-contact check, in 24-hour HH:MM format (e.g. '07:00'). Defaults to '07:00'.",
      "default": "07:00"
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last completed stale-contact check run (set by the backend function)."
    },
    "last_alert_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of stale contacts found in the last run (denormalized for display)."
    }
  },
  "required": [
    "days_threshold"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}