{
  "name": "DueDiligenceStatusOption",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of a due diligence status option (managed master list, reusable across due diligence records)"
    },
    "category": {
      "type": "string",
      "enum": [
        "Due Diligence Status",
        "Due Diligence Process Status"
      ],
      "description": "Which dropdown this option belongs to"
    },
    "sort_order": {
      "type": "integer",
      "default": 0,
      "description": "Display order for this option within its category. Lower values appear first. Managed via the reorder controls in the status dropdown's manage mode."
    },
    "is_hidden": {
      "type": "boolean",
      "default": false,
      "description": "When true, this option is hidden from the dropdown. Used to hide built-in default options that the user has removed via manage mode (defaults cannot be permanently deleted, only hidden)."
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}