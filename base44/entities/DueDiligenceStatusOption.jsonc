{
  "name": "DueDiligenceStatusOption",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of a due diligence status option (managed master list, reusable across due diligence records)"
    },
    "category": {
      "type": "string",
      "enum": [
        "Due Diligence Status",
        "Due Diligence Process Status"
      ],
      "description": "Which dropdown this option belongs to"
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}