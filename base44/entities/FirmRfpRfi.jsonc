{
  "name": "FirmRfpRfi",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "ID of the firm (tenant) that owns this RFP/RFI record. Set on creation to the creator's linked_firm_id; drives tenant isolation via RLS."
    },
    "firm_id": {
      "type": "string",
      "description": "ID of the firm whose website was scrubbed for this RFP/RFI posting."
    },
    "firm_name": {
      "type": "string",
      "description": "Name of the firm (denormalized for display)."
    },
    "title": {
      "type": "string",
      "description": "Title or name of the RFP/RFI posting."
    },
    "rfp_type": {
      "type": "string",
      "enum": [
        "RFP",
        "RFI",
        "Unknown"
      ],
      "default": "Unknown",
      "description": "Whether this posting is a Request for Proposal (RFP) or Request for Information (RFI)."
    },
    "posting_date": {
      "type": "string",
      "format": "date",
      "description": "Date the RFP/RFI was posted (YYYY-MM-DD)."
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Start date of the RFP/RFI \u2014 when it opens (YYYY-MM-DD)."
    },
    "questions_start_date": {
      "type": "string",
      "format": "date",
      "description": "Start date for submitting questions about the RFP/RFI (YYYY-MM-DD)."
    },
    "questions_end_date": {
      "type": "string",
      "format": "date",
      "description": "End date for submitting questions about the RFP/RFI (YYYY-MM-DD)."
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Submission due date of the RFP/RFI (YYYY-MM-DD)."
    },
    "summary": {
      "type": "string",
      "description": "AI-generated summary of the RFP/RFI posting found during the website scrub."
    },
    "source_url": {
      "type": "string",
      "description": "URL where the RFP/RFI was found during scraping."
    },
    "file_url": {
      "type": "string",
      "description": "URL of an attached file (the RFP/RFI document). Populated from the scrape when a downloadable document URL is available, or via manual upload."
    },
    "file_name": {
      "type": "string",
      "description": "Display name of the attached file."
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "Closed",
        "Unknown"
      ],
      "default": "Unknown",
      "description": "Status derived from the due date vs today. 'Open' when due_date is today or later; 'Closed' when due_date is in the past; 'Unknown' when no due date."
    },
    "progress_status": {
      "type": "string",
      "enum": [
        "Draft",
        "Submitted",
        "Under Review",
        "Awarded",
        "Not Awarded",
        "Cancelled"
      ],
      "default": "Draft",
      "description": "Workflow progress of this RFP/RFI through the response cycle. 'Draft' = not yet started; 'Submitted' = response sent in; 'Under Review' = awaiting the firm's decision; 'Awarded' / 'Not Awarded' = decision received; 'Cancelled' = no longer being pursued. The terminal states (Awarded, Not Awarded, Cancelled) are treated as 'completed' and can be hidden from the active views."
    },
    "decision_status": {
      "type": "string",
      "enum": [
        "Needs Review",
        "Submitted",
        "Passed"
      ],
      "default": "Needs Review",
      "description": "Internal go/no-go decision tag for this opportunity. 'Needs Review' = the team has not yet decided whether to pursue; 'Submitted' = the team decided to (or did) submit a proposal; 'Passed' = the team decided to pass on this opportunity."
    },
    "notes": {
      "type": "string",
      "description": "Internal team notes for this RFP/RFI \u2014 feedback, meeting summaries, strategy updates, or context captured directly on the item."
    },
    "product_match_status": {
      "type": "string",
      "enum": [
        "Not Checked",
        "Match",
        "Near Match",
        "No Match"
      ],
      "default": "Not Checked",
      "description": "Result of matching this RFP/RFI against the user's own firm's (Xponance) products. 'Match' = a product clearly fits the opportunity; 'Near Match' = a product is a close but imperfect fit; 'No Match' = no offered product fits; 'Not Checked' = the match has not been run yet."
    },
    "matched_product_ids": {
      "type": "array",
      "description": "IDs of the user's own firm's products that match (or nearly match) this RFP/RFI, identified by the product-match check.",
      "items": {
        "type": "string"
      }
    },
    "matched_product_names": {
      "type": "array",
      "description": "Names of the matched products (denormalized for display).",
      "items": {
        "type": "string"
      }
    },
    "product_match_summary": {
      "type": "string",
      "description": "AI-generated explanation of the product match \u2014 which products fit and why, or why none fit."
    },
    "product_alignment": {
      "type": "array",
      "description": "Detailed feature-by-feature alignment breakdown produced by the product-match check. One entry per plausible-fit product, scoring how well that product's features satisfy each key requirement of the opportunity (Strong / Partial / Gap). Powers the 'Compare Alignment' view in the RFP/RFI dashboard. Empty when no product fits (No Match) or the match has not been run.",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "description": "ID of the candidate product."
          },
          "product_name": {
            "type": "string",
            "description": "Name of the candidate product (denormalized)."
          },
          "overall_fit": {
            "type": "string",
            "enum": [
              "Strong",
              "Partial",
              "Gap"
            ],
            "description": "Overall alignment of this product with the opportunity. 'Strong' = clearly fits; 'Partial' = close but imperfect; 'Gap' = does not fit."
          },
          "criteria": {
            "type": "array",
            "description": "Per-requirement alignment scores. Each entry pairs a key requirement of the opportunity (e.g. asset class, geography, style, mandate size, vehicle) with a strength and a short note.",
            "items": {
              "type": "object",
              "properties": {
                "requirement": {
                  "type": "string",
                  "description": "The key requirement being scored (e.g. 'Asset Class', 'Geography', 'Investment Style')."
                },
                "alignment": {
                  "type": "string",
                  "enum": [
                    "Strong",
                    "Partial",
                    "Gap"
                  ],
                  "description": "How well this product satisfies this requirement."
                },
                "note": {
                  "type": "string",
                  "description": "Short explanation of the alignment (e.g. 'Emerging markets equity, matches EM mandate')."
                }
              },
              "required": [
                "requirement",
                "alignment"
              ]
            }
          }
        },
        "required": [
          "product_id",
          "overall_fit"
        ]
      }
    },
    "product_match_checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the product match was last run (ISO-8601)."
    },
    "deadline_alert_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the 48-hour deadline alert email was last sent for this record (set by the 'RFP/RFI Deadline Reminders' workflow). Used to deduplicate alerts so the team is notified once per record as its deadline enters the 48-hour window."
    },
    "version_history": {
      "type": "array",
      "description": "Version history log tracking updates and previous drafts of this RFP/RFI. Each entry records a single field change with its previous and new values, who made the change, when, and an optional note. File attachment changes are tracked so previous proposal drafts remain visible in the history.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version_number": {
            "type": "integer",
            "description": "Sequential version number for this change (1-based, increments per change)."
          },
          "field": {
            "type": "string",
            "description": "Name of the field that changed."
          },
          "field_label": {
            "type": "string",
            "description": "Human-readable label for the changed field."
          },
          "previous_value": {
            "description": "Value of the field before the change (summarized for large/array fields)."
          },
          "new_value": {
            "description": "Value of the field after the change (summarized for large/array fields)."
          },
          "changed_by_id": {
            "type": "string",
            "description": "User ID of the person who made the change."
          },
          "changed_by_name": {
            "type": "string",
            "description": "Display name of the person who made the change (denormalized)."
          },
          "changed_date": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the change was made (ISO-8601)."
          },
          "note": {
            "type": "string",
            "description": "Optional note describing the change."
          }
        },
        "required": [
          "field",
          "changed_date"
        ]
      }
    },
    "scrub_batch_id": {
      "type": "string",
      "description": "ID of the scrape batch that produced this record (for deduplication)."
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this record was soft-deleted."
    }
  },
  "required": [
    "firm_id",
    "firm_name",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.linked_firm_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.linked_firm_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.linked_firm_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.firm_role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "data.firm_role": "co-admin"
                  }
                },
                {
                  "user_condition": {
                    "data.can_edit": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.linked_firm_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.firm_role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "data.firm_role": "co-admin"
                  }
                },
                {
                  "user_condition": {
                    "data.can_delete": true
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}