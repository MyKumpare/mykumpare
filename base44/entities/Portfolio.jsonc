{
  "name": "Portfolio",
  "type": "object",
  "properties": {
    "firm_id": {
      "type": "string",
      "description": "ID of the associated allocator firm"
    },
    "allocator_name": {
      "type": "string",
      "description": "Name of the allocator firm (denormalized)"
    },
    "portfolio_name": {
      "type": "string",
      "description": "Name of the portfolio"
    },
    "inception_date": {
      "type": "string",
      "format": "date",
      "description": "Inception date of the portfolio"
    },
    "termination_date": {
      "type": "string",
      "format": "date",
      "description": "Termination date of the portfolio (YYYY-MM-DD). Empty/null means the portfolio is still active."
    },
    "funding_status": {
      "type": "string",
      "enum": [
        "Active",
        "Terminated"
      ],
      "default": "Active",
      "description": "Funding status of the portfolio"
    },
    "initial_allocation_amount": {
      "type": "number",
      "description": "Initial allocation amount for the portfolio"
    },
    "advisor_type": {
      "type": "string",
      "enum": [
        "Investment Manager"
      ],
      "description": "Type of advisor managing this portfolio. Always 'Investment Manager' \u2014 the advisor firm is an Investment Manager hired to run the product."
    },
    "advisor_product_type": {
      "type": "string",
      "enum": [
        "Investment Manager Product",
        "Multi-Manager Product"
      ],
      "description": "The type of product the advisor (Investment Manager) is hired to run. 'Multi-Manager Product' uses sub-managers (other Investment Managers); 'Investment Manager Product' has no sub-managers."
    },
    "advisor_firm_id": {
      "type": "string",
      "description": "ID of the advisor firm (Investment Manager)"
    },
    "advisor_firm_name": {
      "type": "string",
      "description": "Name of the advisor firm (denormalized)"
    },
    "advisor_product_id": {
      "type": "string",
      "description": "ID of the specific advisor firm product selected for this portfolio (filtered by advisor_product_type)"
    },
    "advisor_product_name": {
      "type": "string",
      "description": "Name of the selected advisor firm product (denormalized)"
    },
    "advisor_inception_date": {
      "type": "string",
      "format": "date",
      "description": "Inception date of the advisor (Investment Manager) for this portfolio"
    },
    "advisor_termination_date": {
      "type": "string",
      "format": "date",
      "description": "Termination date of the advisor (Investment Manager) for this portfolio (YYYY-MM-DD)"
    },
    "advisor_funding_status": {
      "type": "string",
      "enum": [
        "Active",
        "Terminated"
      ],
      "default": "Active",
      "description": "Funding status of the advisor (Investment Manager) for this portfolio"
    },
    "advisor_initial_allocation_amount": {
      "type": "number",
      "description": "Initial allocation amount for the advisor (Investment Manager) for this portfolio"
    },
    "sub_managers": {
      "type": "array",
      "description": "Sub-manager products (only for Multi-Manager Product advisor product type). These are other Investment Managers' products that the advisor allocates to.",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "firm_name": {
            "type": "string"
          },
          "inception_date": {
            "type": "string",
            "format": "date",
            "description": "Inception date of this sub-manager in the portfolio"
          },
          "termination_date": {
            "type": "string",
            "format": "date",
            "description": "Termination date of this sub-manager in the portfolio (YYYY-MM-DD)"
          },
          "funding_status": {
            "type": "string",
            "enum": [
              "Active",
              "Terminated"
            ],
            "default": "Active",
            "description": "Funding status of this sub-manager"
          },
          "initial_allocation_amount": {
            "type": "number",
            "description": "Initial allocation amount for this sub-manager in the portfolio"
          }
        }
      }
    },
    "primary_benchmark_id": {
      "type": "string",
      "description": "ID of the primary benchmark for this portfolio"
    },
    "primary_benchmark_name": {
      "type": "string",
      "description": "Name of the primary benchmark (denormalized for display)"
    },
    "secondary_benchmarks": {
      "type": "array",
      "description": "Secondary benchmarks associated with this portfolio",
      "items": {
        "type": "object",
        "properties": {
          "benchmark_id": {
            "type": "string",
            "description": "ID of the benchmark"
          },
          "benchmark_name": {
            "type": "string",
            "description": "Name of the benchmark (denormalized for display)"
          }
        }
      }
    },
    "guidelines_investments": {
      "type": "string",
      "description": "Investment guidelines (rich text HTML)"
    },
    "guidelines_program": {
      "type": "string",
      "description": "Program guidelines (rich text HTML)"
    },
    "guidelines_compliance": {
      "type": "string",
      "description": "Compliance guidelines (rich text HTML)"
    },
    "historical_aum": {
      "type": "array",
      "description": "Historical AUM data points (month-by-month). Each entry tracks date, value, and the level it applies to (portfolio total, advisor, or individual sub-manager).",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Date of the AUM data point (YYYY-MM-DD, typically month-end)"
          },
          "value": {
            "type": "number",
            "description": "AUM value on this date"
          },
          "level": {
            "type": "string",
            "enum": [
              "portfolio",
              "advisor",
              "sub_manager"
            ],
            "description": "Which entity this AUM data point applies to"
          },
          "reference_id": {
            "type": "string",
            "description": "ID of the referenced entity (advisor firm ID for 'advisor' level, product ID for 'sub_manager' level, empty for 'portfolio' level)"
          },
          "reference_name": {
            "type": "string",
            "description": "Display name of the referenced entity (denormalized)"
          }
        }
      }
    },
    "allocation_history": {
      "type": "array",
      "description": "Allocation history records tracking funding activities (initial allocations, capital additions, redemptions). Each record can have a supporting document saved to the related firm's document tab.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "activity_date": {
            "type": "string",
            "format": "date",
            "description": "Date of the funding activity (YYYY-MM-DD)"
          },
          "activity_type": {
            "type": "string",
            "enum": [
              "Initial Allocation",
              "Capital Addition",
              "Redemption"
            ],
            "description": "Type of funding activity"
          },
          "amount": {
            "type": "number",
            "description": "Amount of the funding activity"
          },
          "notes": {
            "type": "string",
            "description": "Rich text notes (HTML) about this allocation activity"
          },
          "level": {
            "type": "string",
            "enum": [
              "portfolio",
              "advisor",
              "sub_manager"
            ],
            "description": "Which entity this allocation applies to"
          },
          "reference_id": {
            "type": "string",
            "description": "ID of the referenced entity (advisor firm ID for 'advisor' level, product ID for 'sub_manager' level, empty for 'portfolio' level)"
          },
          "reference_name": {
            "type": "string",
            "description": "Display name of the referenced entity (denormalized)"
          },
          "document": {
            "type": "object",
            "description": "Supporting document attached to this allocation record. Also saved as a FirmDocument record in the related firm's document tab.",
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name of the document"
              },
              "file_url": {
                "type": "string",
                "description": "URL of the uploaded document file"
              },
              "file_type": {
                "type": "string",
                "description": "MIME type or extension of the file"
              },
              "firm_document_id": {
                "type": "string",
                "description": "ID of the corresponding FirmDocument record created for this document"
              }
            }
          }
        }
      }
    },
    "primary_xponance_contact_id": {
      "type": "string",
      "description": "ID of the primary Xponance analyst assigned to this portfolio. The contact must belong to the Xponance (tenant) firm. Set via the Portfolio Coverage dashboard."
    },
    "primary_xponance_contact_name": {
      "type": "string",
      "description": "Full name of the primary Xponance analyst (denormalized for display)."
    },
    "secondary_xponance_contact_id": {
      "type": "string",
      "description": "ID of the secondary Xponance analyst assigned to this portfolio. The contact must belong to the Xponance (tenant) firm. Set via the Portfolio Coverage dashboard."
    },
    "secondary_xponance_contact_name": {
      "type": "string",
      "description": "Full name of the secondary Xponance analyst (denormalized for display)."
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the portfolio was soft-deleted"
    }
  },
  "required": [
    "firm_id",
    "portfolio_name",
    "inception_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.linked_firm_id": "69b18412204649ac3a5b4c88"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.linked_firm_id": "69b18412204649ac3a5b4c88"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.linked_firm_id": "69b18412204649ac3a5b4c88"
          }
        }
      ]
    }
  }
}