{
  "name": "SummaryReportTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the summary report template"
    },
    "description": {
      "type": "string",
      "description": "Optional description of what this template is for"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "Firm",
        "Product",
        "Portfolio",
        "Contact"
      ],
      "description": "The entity type this summary report template applies to (Firm, Product, Portfolio, or Contact). Determines which fields and sections are available to include in the PDF."
    },
    "selected_fields": {
      "type": "array",
      "description": "Ordered list of field keys to include in the generated PDF. Only the selected fields appear in the final download. The order here determines the order of fields in the PDF.",
      "items": {
        "type": "string"
      }
    },
    "page_orientation": {
      "type": "string",
      "enum": [
        "portrait",
        "landscape"
      ],
      "default": "portrait",
      "description": "PDF page orientation"
    },
    "include_cover_page": {
      "type": "boolean",
      "default": false,
      "description": "Whether to add a cover page to the PDF"
    },
    "include_logo": {
      "type": "boolean",
      "default": true,
      "description": "Whether to show the record's logo/photo at the top of the PDF"
    },
    "include_branding": {
      "type": "boolean",
      "default": true,
      "description": "Whether to include the 'Powered by MyKumpare' branding footer on every page"
    },
    "include_summary_metrics": {
      "type": "boolean",
      "default": true,
      "description": "Whether to show a KPI metric strip at the top of the PDF for metric-type fields (e.g. latest AUM, product count)"
    },
    "accent_color": {
      "type": "string",
      "default": "#0d9488",
      "description": "Hex accent color used for section headers and dividers in the PDF"
    }
  },
  "required": [
    "name",
    "entity_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}