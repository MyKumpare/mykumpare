{
  "name": "ContactPipelineStage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the contact pipeline stage (displayed as a Kanban column header)"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Display order of the stage (ascending). Lower values appear first (leftmost) on the Kanban board."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}