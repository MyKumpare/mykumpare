{
  "name": "FirmNews",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "ID of the firm (tenant) that owns this news record. Set on creation to the creator's linked_firm_id; drives tenant isolation via RLS."
    },
    "firm_id": {
      "type": "string",
      "description": "ID of the associated firm"
    },
    "firm_name": {
      "type": "string",
      "description": "Name of the firm (denormalized for display)"
    },
    "news_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the news article (YYYY-MM-DD)"
    },
    "headline": {
      "type": "string",
      "description": "News headline"
    },
    "summary": {
      "type": "string",
      "description": "AI-generated summary of the article"
    },
    "alert_status": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ],
      "default": "Low",
      "description": "Impact-based alert level assigned by the AI scrub. Users can manually override this value; each manual change is recorded in status_change_history."
    },
    "news_status": {
      "type": "string",
      "enum": [
        "Positive",
        "Negative",
        "Neutral"
      ],
      "default": "Neutral",
      "description": "Sentiment of the news article. Users can manually override this value; each manual change is recorded in status_change_history."
    },
    "article_url": {
      "type": "string",
      "description": "URL link to the original news article"
    },
    "notes": {
      "type": "string",
      "description": "User-added notes (rich text HTML)"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "Whether this news item is pinned in the Monitor News Alerts section"
    },
    "is_hidden": {
      "type": "boolean",
      "default": false,
      "description": "Whether this news item is hidden from the default news views (Monitor, firm news tab, contact news tab). Hidden items are excluded from lists unless the user toggles 'show hidden'."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "firm",
        "contact",
        "product"
      ],
      "default": "firm",
      "description": "What the news relates to (firm, contact, or product)"
    },
    "source_id": {
      "type": "string",
      "description": "ID of the related contact or product (if source_type is not 'firm')"
    },
    "source_name": {
      "type": "string",
      "description": "Name of the related contact or product (denormalized)"
    },
    "tagged_contact_ids": {
      "type": "array",
      "description": "IDs of contacts mentioned in this news article. Tagged contacts see the news item in their contact News tab.",
      "items": {
        "type": "string"
      }
    },
    "tagged_firm_ids": {
      "type": "array",
      "description": "IDs of firms tagged in this news article. Tagged firms see the news item in their firm News tab.",
      "items": {
        "type": "string"
      }
    },
    "content_tags": {
      "type": "array",
      "description": "User-assigned content tags for this news article (e.g. 'Newsletter', 'Research Paper'). Users can add custom tags beyond the defaults.",
      "items": {
        "type": "string"
      }
    },
    "status_change_history": {
      "type": "array",
      "description": "Audit log of manual changes to alert_status or news_status. Each entry records the field changed, previous and new values, who made the change, when, and a justification note. The last entry for a given field is used to display the 'edited by' hover indicator on the badge.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "field": {
            "type": "string",
            "enum": [
              "alert_status",
              "news_status"
            ],
            "description": "Which status field was changed"
          },
          "previous_value": {
            "type": "string",
            "description": "The value before this change"
          },
          "new_value": {
            "type": "string",
            "description": "The value after this change"
          },
          "changed_by_id": {
            "type": "string",
            "description": "User ID of the person who made the change"
          },
          "changed_by_name": {
            "type": "string",
            "description": "Display name of the person who made the change (denormalized)"
          },
          "changed_date": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the change was made"
          },
          "note": {
            "type": "string",
            "description": "Justification note provided by the user for this change"
          }
        }
      }
    },
    "scrub_batch_id": {
      "type": "string",
      "description": "ID of the scrub batch that produced this news item (for deduplication)"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this news item was soft-deleted"
    }
  },
  "required": [
    "firm_id",
    "firm_name",
    "headline"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.linked_firm_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.linked_firm_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.linked_firm_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.firm_role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "data.firm_role": "co-admin"
                  }
                },
                {
                  "user_condition": {
                    "data.can_edit": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.linked_firm_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.firm_role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "data.firm_role": "co-admin"
                  }
                },
                {
                  "user_condition": {
                    "data.can_delete": true
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}