{
  "name": "FirmConference",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "ID of the firm (tenant) that owns this conference record. Set on creation to the creator's linked_firm_id; drives tenant isolation via RLS."
    },
    "firm_id": {
      "type": "string",
      "description": "ID of the associated firm"
    },
    "firm_name": {
      "type": "string",
      "description": "Name of the firm (denormalized for display)"
    },
    "conference_date": {
      "type": "string",
      "format": "date",
      "description": "Start date of the conference (YYYY-MM-DD). When only a month/year is known, the first day of the known period is stored."
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "End date of the conference (YYYY-MM-DD), if known."
    },
    "title": {
      "type": "string",
      "description": "Title/name of the conference"
    },
    "description": {
      "type": "string",
      "description": "Short description of the conference (what it is about)"
    },
    "location": {
      "type": "string",
      "description": "Location of the conference (city, state, country, or venue)"
    },
    "fees": {
      "type": "string",
      "description": "Registration fees for the conference (free text, e.g. '$1,200', 'Free', 'See website')"
    },
    "url": {
      "type": "string",
      "description": "URL link to the conference website or details page"
    },
    "participation_type": {
      "type": "string",
      "enum": [
        "Sponsoring",
        "Attending",
        "Speaking",
        "Exhibiting",
        "Unknown"
      ],
      "default": "Unknown",
      "description": "How the firm or its contact is involved in the conference"
    },
    "rsvp_status": {
      "type": "string",
      "enum": [
        "Not Responded",
        "Confirmed",
        "Tentative",
        "Declined"
      ],
      "default": "Not Responded",
      "description": "Internal RSVP/attendance status for this firm's participation in the conference. Managed by the team to track whether the firm has committed to attending."
    },
    "registration_status": {
      "type": "string",
      "enum": [
        "Not Registered",
        "Registered",
        "Waitlisted"
      ],
      "default": "Not Registered",
      "description": "Registration status for this conference \u2014 whether the team has registered the firm to attend. Managed by the team to track registration progress."
    },
    "sponsorship_status": {
      "type": "string",
      "enum": [
        "Not Sponsoring",
        "Considering",
        "Sponsoring"
      ],
      "default": "Not Sponsoring",
      "description": "Whether the firm is sponsoring this conference. 'Considering' means sponsorship is under discussion but not yet confirmed."
    },
    "sponsorship_amount": {
      "type": "number",
      "description": "Sponsorship amount the firm is paying (or will pay) for this conference, in dollars."
    },
    "sponsorship_deliverables": {
      "type": "string",
      "description": "What the firm receives in exchange for sponsoring (e.g. booth, logo placement, speaking slot, attendee passes). Free text."
    },
    "internal_attendee_contact_ids": {
      "type": "array",
      "description": "IDs of internal colleagues (contacts from the user's own firm) who are attending this conference. Used for internal coordination of who is going to each event.",
      "items": {
        "type": "string"
      }
    },
    "internal_notes": {
      "type": "string",
      "description": "Internal team notes about this conference attendance record (e.g. who is going, logistics, follow-ups). Free text."
    },
    "source_contact_name": {
      "type": "string",
      "description": "Name of the contact through whom this conference was found (if the conference relates to a contact rather than the firm directly)"
    },
    "scrub_batch_id": {
      "type": "string",
      "description": "ID of the scrub batch that produced this conference record (for deduplication)"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this conference record was soft-deleted"
    }
  },
  "required": [
    "firm_id",
    "firm_name",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.linked_firm_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.linked_firm_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.linked_firm_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.firm_role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "data.firm_role": "co-admin"
                  }
                },
                {
                  "user_condition": {
                    "data.can_edit": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.linked_firm_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.firm_role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "data.firm_role": "co-admin"
                  }
                },
                {
                  "user_condition": {
                    "data.can_delete": true
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}