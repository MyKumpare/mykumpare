{
  "name": "ExternalChat",
  "type": "object",
  "properties": {
    "due_diligence_id": {
      "type": "string",
      "description": "ID of the related DueDiligence record"
    },
    "external_firm_id": {
      "type": "string",
      "description": "ID of the external firm involved in the chat"
    },
    "external_firm_name": {
      "type": "string",
      "description": "External firm name (denormalized)"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ],
      "default": "inbound",
      "description": "Direction of the initial message. 'inbound' = external firm sent to analyst, 'outbound' = analyst sent to external firm."
    },
    "sender_contact_id": {
      "type": "string",
      "description": "ID of the contact who sent the initial message"
    },
    "sender_name": {
      "type": "string",
      "description": "Name of the sender (denormalized)"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of the sender (denormalized)"
    },
    "external_contact_id": {
      "type": "string",
      "description": "ID of the external firm contact involved in the chat (sender for inbound, recipient for outbound)"
    },
    "external_contact_name": {
      "type": "string",
      "description": "Name of the external contact (denormalized)"
    },
    "analyst_contact_id": {
      "type": "string",
      "description": "ID of the primary analyst (internal user) involved in the chat"
    },
    "analyst_name": {
      "type": "string",
      "description": "Name of the primary analyst (denormalized)"
    },
    "product_name": {
      "type": "string",
      "description": "Product name associated with the due diligence (denormalized)"
    },
    "message": {
      "type": "string",
      "description": "Initial chat message"
    },
    "response": {
      "type": "string",
      "description": "Response from the other party"
    },
    "received_date": {
      "type": "string",
      "format": "date",
      "description": "Date the initial message was sent (auto-set to today, stored YYYY-MM-DD)"
    },
    "responded_date": {
      "type": "string",
      "format": "date",
      "description": "Date the response was sent (auto-set to today, stored YYYY-MM-DD)"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "pending",
        "completed"
      ],
      "default": "pending",
      "description": "Conversation status. 'open' = active/open conversation, 'pending' = waiting for a reply, 'completed' = resolved."
    }
  },
  "required": [
    "external_firm_id",
    "sender_contact_id",
    "analyst_contact_id",
    "message",
    "status"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.external_firm_id": "{{user.data.linked_firm_id}}"
        },
        {
          "data.analyst_contact_id": "{{user.data.linked_contact_id}}"
        },
        {
          "data.external_contact_id": "{{user.data.linked_contact_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.analyst_contact_id": "{{user.data.linked_contact_id}}"
        },
        {
          "data.external_firm_id": "{{user.data.linked_firm_id}}"
        },
        {
          "data.external_contact_id": "{{user.data.linked_contact_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}