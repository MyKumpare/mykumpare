{
  "name": "DueDiligence",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "ID of the firm (tenant) that owns this due diligence record. Set on creation to the creator's linked_firm_id; drives tenant isolation via RLS."
    },
    "firm_id": {
      "type": "string",
      "description": "ID of the firm this due diligence record belongs to"
    },
    "firm_name": {
      "type": "string",
      "description": "Name of the associated firm (denormalized)"
    },
    "product_id": {
      "type": "string",
      "description": "ID of the product under due diligence"
    },
    "product_name": {
      "type": "string",
      "description": "Name of the product under due diligence (denormalized)"
    },
    "status": {
      "type": "string",
      "default": "Pipeline",
      "description": "Due diligence status (extensible via DueDiligenceStatusOption master list)"
    },
    "process_status": {
      "type": "string",
      "default": "Not Started",
      "description": "Due diligence process status (extensible via DueDiligenceStatusOption master list)"
    },
    "primary_analyst_contact_id": {
      "type": "string",
      "description": "ID of the primary analyst (a contact from the firm)"
    },
    "primary_analyst_name": {
      "type": "string",
      "description": "Full name of the primary analyst (denormalized)"
    },
    "secondary_analyst_contact_id": {
      "type": "string",
      "description": "ID of the secondary analyst (a contact from the firm)"
    },
    "secondary_analyst_name": {
      "type": "string",
      "description": "Full name of the secondary analyst (denormalized)"
    },
    "template_id": {
      "type": "string",
      "description": "ID of the due diligence template that defines the stages for this record"
    },
    "template_name": {
      "type": "string",
      "description": "Name of the due diligence template (denormalized)"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Date the due diligence was started (auto-set to today, user-editable). Stored as YYYY-MM-DD."
    },
    "current_stage_index": {
      "type": "integer",
      "default": 0,
      "description": "0-based index of the currently active stage."
    },
    "assigned_contact_ids": {
      "type": "array",
      "description": "Denormalized list of all contact IDs assigned to any sub-stage in this record. Used for fast lookup in the contact Due Diligence tab.",
      "items": {
        "type": "string"
      }
    },
    "stages": {
      "type": "array",
      "description": "Due diligence stages (loaded from template). Each stage tracks completion status, supervisor approval, and dates. Sub-stages within a stage can be worked on in any order (non-sequential). A stage is completed only when all sub-stages are completed and the supervisor approves.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "completed": {
            "type": "boolean",
            "description": "Whether this stage has been completed (all sub-stages done + supervisor approved)"
          },
          "completed_date": {
            "type": "string",
            "format": "date",
            "description": "Date the stage was completed (YYYY-MM-DD)"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "Date work began on this stage (auto-set when first sub-stage is started, user-editable). Stored as YYYY-MM-DD."
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "Date work ended on this stage (auto-set on supervisor approval, user-editable). Stored as YYYY-MM-DD."
          },
          "notes": {
            "type": "string",
            "description": "Rich text notes (HTML) for this stage, entered by the user in a Word-style editor."
          },
          "supervisor_status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "on_hold"
            ],
            "default": "pending",
            "description": "Supervisor approval status for this stage. Stage is only completed when status is 'approved'."
          },
          "supervisor_contact_id": {
            "type": "string",
            "description": "ID of the supervisor who approved/rejected/put on hold"
          },
          "supervisor_name": {
            "type": "string",
            "description": "Name of the supervisor (denormalized)"
          },
          "supervisor_date": {
            "type": "string",
            "format": "date",
            "description": "Date the supervisor action was taken (YYYY-MM-DD)"
          },
          "sub_stages": {
            "type": "array",
            "description": "Ordered sub-stages within this stage (loaded from template). Sub-stages can be worked on in any order.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "start_date": {
                  "type": "string",
                  "format": "date",
                  "description": "Date work began on this sub-stage (auto-set to today when started, user-editable). Stored as YYYY-MM-DD."
                },
                "end_date": {
                  "type": "string",
                  "format": "date",
                  "description": "Date work ended on this sub-stage (auto-set to today when completed, user-editable). Stored as YYYY-MM-DD."
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "not_started",
                    "in_process",
                    "completed"
                  ],
                  "default": "not_started",
                  "description": "Completion status of this sub-stage"
                },
                "notes": {
                  "type": "string",
                  "description": "Rich text notes (HTML) for this sub-stage, entered by the user in a Word-style editor."
                },
                "performed_by_contact_id": {
                  "type": "string",
                  "description": "ID of the contact who performed/completed this sub-stage (auto-set to primary analyst, user-editable)"
                },
                "performed_by_name": {
                  "type": "string",
                  "description": "Name of the contact who performed this sub-stage (denormalized)"
                },
                "assignments": {
                  "type": "array",
                  "description": "Team members assigned to this sub-stage, each with their own due date and status",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "contact_id": {
                        "type": "string",
                        "description": "ID of the assigned team member"
                      },
                      "contact_name": {
                        "type": "string",
                        "description": "Name of the assigned team member (denormalized)"
                      },
                      "assigned_date": {
                        "type": "string",
                        "format": "date",
                        "description": "Date the sub-stage was assigned to this member (auto-set to today)"
                      },
                      "due_date": {
                        "type": "string",
                        "format": "date",
                        "description": "Due date for this assignment (user-set)"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "not_started",
                          "in_process",
                          "completed"
                        ],
                        "default": "not_started",
                        "description": "Status of this assignment for this team member"
                      },
                      "status_date": {
                        "type": "string",
                        "format": "date",
                        "description": "Date the assignment status was last changed"
                      },
                      "notes": {
                        "type": "string",
                        "description": "Notes from the assigned team member"
                      }
                    }
                  }
                },
                "attachments": {
                  "type": "array",
                  "description": "Files attached to this sub-stage",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string",
                        "description": "Display name for the file"
                      },
                      "file_url": {
                        "type": "string",
                        "description": "URL of the uploaded file"
                      },
                      "file_type": {
                        "type": "string",
                        "description": "MIME type or extension"
                      },
                      "uploaded_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "firm_id",
    "product_id",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.linked_firm_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.linked_firm_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.linked_firm_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.firm_role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "data.firm_role": "co-admin"
                  }
                },
                {
                  "user_condition": {
                    "data.can_edit": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.linked_firm_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.firm_role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "data.firm_role": "co-admin"
                  }
                },
                {
                  "user_condition": {
                    "data.can_delete": true
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}