{
  "name": "DueDiligence",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "ID of the firm (tenant) that owns this due diligence record. Set on creation to the creator's linked_firm_id; drives tenant isolation via RLS."
    },
    "firm_id": {
      "type": "string",
      "description": "ID of the firm this due diligence record belongs to"
    },
    "firm_name": {
      "type": "string",
      "description": "Name of the associated firm (denormalized)"
    },
    "product_id": {
      "type": "string",
      "description": "ID of the product under due diligence"
    },
    "product_name": {
      "type": "string",
      "description": "Name of the product under due diligence (denormalized)"
    },
    "status": {
      "type": "string",
      "default": "Pipeline",
      "description": "Due diligence status (extensible via DueDiligenceStatusOption master list)"
    },
    "process_status": {
      "type": "string",
      "default": "Not Started",
      "description": "Due diligence process status (extensible via DueDiligenceStatusOption master list)"
    },
    "primary_analyst_contact_id": {
      "type": "string",
      "description": "ID of the primary analyst (a contact from the firm)"
    },
    "primary_analyst_name": {
      "type": "string",
      "description": "Full name of the primary analyst (denormalized)"
    },
    "secondary_analyst_contact_id": {
      "type": "string",
      "description": "ID of the secondary analyst (a contact from the firm)"
    },
    "secondary_analyst_name": {
      "type": "string",
      "description": "Full name of the secondary analyst (denormalized)"
    },
    "analyst_history": {
      "type": "array",
      "description": "History of primary and secondary analyst assignments. Each entry tracks the analyst type, contact, and start/end dates of coverage. When an analyst is changed, the previous entry is closed (end_date set) and a new entry is opened (start_date set).",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "analyst_type": {
            "type": "string",
            "enum": [
              "primary",
              "secondary"
            ],
            "description": "Whether this was a primary or secondary analyst assignment"
          },
          "contact_id": {
            "type": "string",
            "description": "ID of the analyst contact"
          },
          "contact_name": {
            "type": "string",
            "description": "Full name of the analyst (denormalized)"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "Date the analyst started coverage (YYYY-MM-DD)"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "Date the analyst ended coverage (YYYY-MM-DD). Null/empty means the analyst is currently active."
          }
        }
      }
    },
    "template_id": {
      "type": "string",
      "description": "ID of the due diligence template that defines the stages for this record"
    },
    "template_name": {
      "type": "string",
      "description": "Name of the due diligence template (denormalized)"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Date the due diligence was started (auto-set to today, user-editable). Stored as YYYY-MM-DD."
    },
    "current_stage_index": {
      "type": "integer",
      "default": 0,
      "description": "0-based index of the currently active stage."
    },
    "assigned_contact_ids": {
      "type": "array",
      "description": "Denormalized list of all contact IDs assigned to any sub-stage in this record. Used for fast lookup in the contact Due Diligence tab.",
      "items": {
        "type": "string"
      }
    },
    "stages": {
      "type": "array",
      "description": "Due diligence stages (loaded from template). Each stage tracks completion status, supervisor approval, and dates. Sub-stages within a stage can be worked on in any order (non-sequential). A stage is completed only when all sub-stages are completed and the supervisor approves.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "completed": {
            "type": "boolean",
            "description": "Whether this stage has been completed (all sub-stages done + supervisor approved)"
          },
          "completed_date": {
            "type": "string",
            "format": "date",
            "description": "Date the stage was completed (YYYY-MM-DD)"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "Date work began on this stage (auto-set when first sub-stage is started, user-editable). Stored as YYYY-MM-DD."
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "Date work ended on this stage (auto-set on supervisor approval, user-editable). Stored as YYYY-MM-DD."
          },
          "notes": {
            "type": "string",
            "description": "Rich text notes (HTML) for this stage, entered by the user in a Word-style editor."
          },
          "supervisor_status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "on_hold"
            ],
            "default": "pending",
            "description": "Supervisor approval status for this stage. Stage is only completed when status is 'approved'."
          },
          "supervisor_contact_id": {
            "type": "string",
            "description": "ID of the supervisor who approved/rejected/put on hold"
          },
          "supervisor_name": {
            "type": "string",
            "description": "Name of the supervisor (denormalized)"
          },
          "supervisor_date": {
            "type": "string",
            "format": "date",
            "description": "Date the supervisor action was taken (YYYY-MM-DD)"
          },
          "rejection_feedback": {
            "type": "string",
            "description": "Feedback provided by the supervisor when rejecting this stage. Explains the reason for rejection and any required corrective actions. Shown in the rejection notification sent to the analyst team."
          },
          "comments": {
            "type": "array",
            "description": "Team discussion comments attached to this stage, allowing team members to discuss feedback directly within the kanban board. Each comment records the author, text, and timestamp.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier for this comment"
                },
                "author_id": {
                  "type": "string",
                  "description": "User ID of the comment author"
                },
                "author_name": {
                  "type": "string",
                  "description": "Display name of the comment author (denormalized)"
                },
                "text": {
                  "type": "string",
                  "description": "Comment text body"
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time",
                  "description": "ISO-8601 timestamp when the comment was posted"
                }
              },
              "required": [
                "id",
                "text",
                "timestamp"
              ]
            }
          },
          "sub_stages": {
            "type": "array",
            "description": "Ordered sub-stages within this stage (loaded from template). Sub-stages can be worked on in any order.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "start_date": {
                  "type": "string",
                  "format": "date",
                  "description": "Date work began on this sub-stage (auto-set to today when started, user-editable). Stored as YYYY-MM-DD."
                },
                "end_date": {
                  "type": "string",
                  "format": "date",
                  "description": "Date work ended on this sub-stage (auto-set to today when completed, user-editable). Stored as YYYY-MM-DD."
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "not_started",
                    "in_process",
                    "completed"
                  ],
                  "default": "not_started",
                  "description": "Completion status of this sub-stage"
                },
                "notes": {
                  "type": "string",
                  "description": "Rich text notes (HTML) for this sub-stage, entered by the user in a Word-style editor."
                },
                "performed_by_contact_id": {
                  "type": "string",
                  "description": "ID of the contact who performed/completed this sub-stage (auto-set to primary analyst, user-editable)"
                },
                "performed_by_name": {
                  "type": "string",
                  "description": "Name of the contact who performed this sub-stage (denormalized)"
                },
                "assignments": {
                  "type": "array",
                  "description": "Team members assigned to this sub-stage, each with their own due date and status",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "contact_id": {
                        "type": "string",
                        "description": "ID of the assigned team member"
                      },
                      "contact_name": {
                        "type": "string",
                        "description": "Name of the assigned team member (denormalized)"
                      },
                      "assigned_date": {
                        "type": "string",
                        "format": "date",
                        "description": "Date the sub-stage was assigned to this member (auto-set to today)"
                      },
                      "due_date": {
                        "type": "string",
                        "format": "date",
                        "description": "Due date for this assignment (user-set)"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "not_started",
                          "in_process",
                          "completed"
                        ],
                        "default": "not_started",
                        "description": "Status of this assignment for this team member"
                      },
                      "status_date": {
                        "type": "string",
                        "format": "date",
                        "description": "Date the assignment status was last changed"
                      },
                      "notes": {
                        "type": "string",
                        "description": "Notes from the assigned team member"
                      }
                    }
                  }
                },
                "attachments": {
                  "type": "array",
                  "description": "Files attached to this sub-stage",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string",
                        "description": "Display name for the file"
                      },
                      "file_url": {
                        "type": "string",
                        "description": "URL of the uploaded file"
                      },
                      "file_type": {
                        "type": "string",
                        "description": "MIME type or extension"
                      },
                      "uploaded_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "documentation_checklist": {
      "type": "array",
      "description": "Documentation checklist items for this due diligence record (copied from template on creation). Each item tracks the attached document, add date, completion status, and notes.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Name of the checklist item (from template)"
          },
          "document_id": {
            "type": "string",
            "description": "ID of the attached FirmDocument record (from the document list related to the product and firm)"
          },
          "document_name": {
            "type": "string",
            "description": "Display name of the attached document (denormalized)"
          },
          "document_url": {
            "type": "string",
            "description": "URL of the attached document file (denormalized for quick access)"
          },
          "add_date": {
            "type": "string",
            "format": "date",
            "description": "Date the document was attached (auto-set to today, user-editable). Stored as YYYY-MM-DD."
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "reviewed",
              "completed"
            ],
            "default": "pending",
            "description": "Completion status of this checklist item"
          },
          "notes": {
            "type": "string",
            "description": "Rich text notes (HTML) for this checklist item"
          }
        }
      }
    },
    "approval_process": {
      "type": "object",
      "description": "Approval process configuration for this due diligence record. The user selects an approver from their team, which is used to populate the approval team.",
      "properties": {
        "approver_contact_id": {
          "type": "string",
          "description": "ID of the selected approver (a contact from the user's team)"
        },
        "approver_name": {
          "type": "string",
          "description": "Name of the selected approver (denormalized)"
        }
      }
    },
    "approval_process_logic": {
      "type": "array",
      "description": "Approval process logic steps for this due diligence record (copied from template on creation). Each step references a due diligence stage/sub-stage and tracks execution data: start date, performer, documents, notes, and task assignments.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Name/description of the process step (from template)"
          },
          "stage_id": {
            "type": "string",
            "description": "ID of the referenced due diligence stage (from template)"
          },
          "stage_name": {
            "type": "string",
            "description": "Name of the referenced stage (denormalized)"
          },
          "sub_stage_id": {
            "type": "string",
            "description": "ID of the referenced sub-stage (optional, from template)"
          },
          "sub_stage_name": {
            "type": "string",
            "description": "Name of the referenced sub-stage (denormalized)"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "Date work began on this process step (auto-set to today, user-editable). Stored as YYYY-MM-DD."
          },
          "performed_by_contact_id": {
            "type": "string",
            "description": "ID of the contact who performed this step (auto-set to current user, user-editable)"
          },
          "performed_by_name": {
            "type": "string",
            "description": "Name of the contact who performed this step (denormalized)"
          },
          "documents": {
            "type": "array",
            "description": "Documents attached to this process step. Each document is also saved as a FirmDocument record in the document tab for the related firm and product.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string",
                  "description": "Display name for the document"
                },
                "file_url": {
                  "type": "string",
                  "description": "URL of the document file"
                },
                "file_type": {
                  "type": "string",
                  "description": "MIME type or extension"
                },
                "firm_document_id": {
                  "type": "string",
                  "description": "ID of the corresponding FirmDocument record created for this document (links to the document tab)"
                },
                "uploaded_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "notes": {
            "type": "string",
            "description": "Rich text notes (HTML) for this process step"
          },
          "task_assignments": {
            "type": "array",
            "description": "Tasks assigned to team members for this process step. These show up in the assignee's notification tab and due diligence tab.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "contact_id": {
                  "type": "string",
                  "description": "ID of the assigned team member"
                },
                "contact_name": {
                  "type": "string",
                  "description": "Name of the assigned team member (denormalized)"
                },
                "due_date": {
                  "type": "string",
                  "format": "date",
                  "description": "Due date for this task (user-set)"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "not_started",
                    "in_process",
                    "completed"
                  ],
                  "default": "not_started",
                  "description": "Status of this task assignment"
                },
                "status_date": {
                  "type": "string",
                  "format": "date",
                  "description": "Date the task status was last changed"
                },
                "notes": {
                  "type": "string",
                  "description": "Notes for this task assignment"
                }
              }
            }
          }
        }
      }
    },
    "process_logic": {
      "type": "array",
      "description": "Process logic gate rules for this due diligence record (copied from template on creation). Each gate sits between two consecutive stages and defines the requirements that must all be satisfied before the process can advance to the next stage. Requirements can include sub-stage completion, document attachment, form completion, score card completion, qualitative/quantitative analysis, and approval. Each requirement tracks its satisfaction status as the due diligence progresses.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for this gate rule"
          },
          "name": {
            "type": "string",
            "description": "Display name for this gate"
          },
          "from_stage_id": {
            "type": "string",
            "description": "ID of the stage that must be completed before this gate can pass"
          },
          "from_stage_name": {
            "type": "string",
            "description": "Name of the source stage (denormalized)"
          },
          "to_stage_id": {
            "type": "string",
            "description": "ID of the next stage that becomes available once this gate passes"
          },
          "to_stage_name": {
            "type": "string",
            "description": "Name of the destination stage (denormalized)"
          },
          "requirements": {
            "type": "array",
            "description": "Ordered list of requirements that must ALL be satisfied for this gate to pass.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "sub_stage_completion",
                    "document_attachment",
                    "form_completion",
                    "score_card_completion",
                    "qualitative_analysis",
                    "quantitative_analysis",
                    "approval"
                  ],
                  "description": "Type of requirement"
                },
                "label": {
                  "type": "string",
                  "description": "Display label for this requirement"
                },
                "stage_id": {
                  "type": "string",
                  "description": "For sub_stage_completion: the stage containing the sub-stage"
                },
                "sub_stage_id": {
                  "type": "string",
                  "description": "For sub_stage_completion: the specific sub-stage that must be completed (empty means all sub-stages in the stage)"
                },
                "document_checklist_item_id": {
                  "type": "string",
                  "description": "For document_attachment: the documentation checklist item ID that must have a document attached"
                },
                "form_id": {
                  "type": "string",
                  "description": "For form_completion: the questionnaire/form ID that must be completed"
                },
                "score_card_template_id": {
                  "type": "string",
                  "description": "For score_card_completion: the scoring matrix template ID that must be completed"
                },
                "analysis_description": {
                  "type": "string",
                  "description": "For qualitative_analysis / quantitative_analysis: a description of what analysis must be completed"
                },
                "approval_role": {
                  "type": "string",
                  "description": "For approval: the role of the approver who must approve"
                },
                "required": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether this requirement is mandatory (true) or optional (false). Optional requirements are shown but do not block the gate."
                },
                "satisfied": {
                  "type": "boolean",
                  "default": false,
                  "description": "Whether this requirement has been satisfied (auto-evaluated from the due diligence state, or manually marked)."
                }
              }
            }
          }
        }
      }
    },
    "stage_approvers": {
      "type": "array",
      "description": "Approvers assigned to each stage (copied from template on creation, with specific contacts assigned to each role). Each required approver must digitally sign off before the process can advance past that stage. Signatures are tracked in the digital_signatures array.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "stage_id": {
            "type": "string",
            "description": "ID of the stage these approvers apply to"
          },
          "stage_name": {
            "type": "string",
            "description": "Name of the stage (denormalized)"
          },
          "approver_roles": {
            "type": "array",
            "description": "Approver roles for this stage, each with a contact assigned at DD creation time.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "description": "Approver role label (e.g. 'Supervisor', 'Investment Committee Chair')"
                },
                "required": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether this role's sign-off is mandatory (true) or optional (false)"
                },
                "contact_id": {
                  "type": "string",
                  "description": "ID of the contact assigned to this approver role. Empty means not yet assigned."
                },
                "contact_name": {
                  "type": "string",
                  "description": "Name of the assigned contact (denormalized)"
                }
              }
            }
          }
        }
      }
    },
    "digital_signatures": {
      "type": "array",
      "description": "Digital sign-off records collected from assigned approvers. Each signature records who signed, when, for which stage, and an optional comment. A stage cannot advance until all its required approvers have signed.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "stage_id": {
            "type": "string",
            "description": "ID of the stage this signature approves"
          },
          "stage_name": {
            "type": "string",
            "description": "Name of the stage (denormalized)"
          },
          "approver_role_id": {
            "type": "string",
            "description": "ID of the stage_approvers approver_role entry this signature fulfills"
          },
          "role": {
            "type": "string",
            "description": "Role of the signer (denormalized from stage_approvers)"
          },
          "contact_id": {
            "type": "string",
            "description": "ID of the contact who signed"
          },
          "contact_name": {
            "type": "string",
            "description": "Name of the contact who signed (denormalized)"
          },
          "signed_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the digital signature was recorded (ISO-8601)"
          },
          "signature_date": {
            "type": "string",
            "format": "date",
            "description": "Date of the signature (YYYY-MM-DD)"
          },
          "comment": {
            "type": "string",
            "description": "Optional comment from the approver accompanying the sign-off"
          },
          "signed_by_user_id": {
            "type": "string",
            "description": "User ID of the person who recorded the signature"
          },
          "signed_by_user_name": {
            "type": "string",
            "description": "Display name of the user who recorded the signature (denormalized)"
          }
        }
      }
    },
    "audit_trail": {
      "type": "array",
      "description": "Chronological audit trail of workflow progression for this due diligence record. Each entry logs a single workflow event \u2014 stage approval, sub-stage completion, digital sign-off, stage advancement, or rejection \u2014 with the actor, timestamp, and contextual details. Appended automatically as the process progresses, providing a full history of who approved each step and when.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for this audit entry"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO-8601 timestamp when the event occurred"
          },
          "action_type": {
            "type": "string",
            "enum": [
              "process_created",
              "stage_started",
              "sub_stage_completed",
              "sub_stage_started",
              "stage_approved",
              "stage_rejected",
              "stage_on_hold",
              "stage_advanced",
              "signature_collected",
              "signature_revoked",
              "bulk_approved"
            ],
            "description": "Type of workflow event"
          },
          "stage_id": {
            "type": "string",
            "description": "ID of the stage this event relates to (empty for process-level events)"
          },
          "stage_name": {
            "type": "string",
            "description": "Name of the stage (denormalized)"
          },
          "sub_stage_id": {
            "type": "string",
            "description": "ID of the sub-stage this event relates to (empty for stage-level events)"
          },
          "sub_stage_name": {
            "type": "string",
            "description": "Name of the sub-stage (denormalized)"
          },
          "actor_id": {
            "type": "string",
            "description": "User ID of the person who performed the action"
          },
          "actor_name": {
            "type": "string",
            "description": "Display name of the person who performed the action (denormalized)"
          },
          "details": {
            "type": "string",
            "description": "Human-readable description of the event"
          }
        },
        "required": [
          "id",
          "timestamp",
          "action_type"
        ]
      }
    },
    "outlook_event_id": {
      "type": "string",
      "description": "ID of the corresponding Outlook Calendar event (set when the due diligence start date is synced to Outlook Calendar)"
    },
    "milestones": {
      "type": "array",
      "description": "Custom milestone tracking points for this due diligence record, independent of the kanban stages. Each milestone marks a specific progress point the team wants to track beyond the stage workflow (e.g. 'Initial call completed', 'Data room access granted', 'On-site visit done'). Milestones are user-created, have a target date and optional notes, and can be toggled complete independently of stage progression.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Name/label of the milestone"
          },
          "description": {
            "type": "string",
            "description": "Optional notes or details about this milestone"
          },
          "target_date": {
            "type": "string",
            "format": "date",
            "description": "Target date for completing this milestone (YYYY-MM-DD)"
          },
          "completed_date": {
            "type": "string",
            "format": "date",
            "description": "Date the milestone was marked complete (auto-set to today when toggled on, cleared when toggled off). Stored as YYYY-MM-DD."
          },
          "completed": {
            "type": "boolean",
            "default": false,
            "description": "Whether this milestone has been achieved"
          },
          "created_date": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the milestone was created (auto-set on creation)"
          },
          "created_by_name": {
            "type": "string",
            "description": "Display name of the user who created this milestone (denormalized)"
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    }
  },
  "required": [
    "firm_id",
    "product_id",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.linked_firm_id": "69b18412204649ac3a5b4c88"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.linked_firm_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.linked_firm_id": "69b18412204649ac3a5b4c88"
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.firm_role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "data.firm_role": "co-admin"
                  }
                },
                {
                  "user_condition": {
                    "data.can_edit": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.linked_firm_id": "69b18412204649ac3a5b4c88"
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.firm_role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "data.firm_role": "co-admin"
                  }
                },
                {
                  "user_condition": {
                    "data.can_delete": true
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}